<?xml version="1.0" encoding="utf-8"?>
<!-- A file manager opens arbitrary addresses the user types or links to:
     intranet NAS pages, router UIs, localhost dev servers. There is no fixed
     host list to allowlist, so cleartext HTTP must be permitted app-wide for
     both the WebView and the HTTP provider. The DevTools loopback bridge is
     covered by the same rule. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
