+static void test_freeze_thaw(void)
+{
+	char counter[128];
+	char value[32];
+	pid_t child, moved;
+	struct stat st;
+	off_t before, after;
+
+	snprintf(counter, sizeof(counter), "/tmp/proot-cg-counter-%d", (int) getpid());
+	unlink(counter);
+	make_group("fz");
+
+	child = fork();
+	if (child < 0)
+		fail("fork");
+	if (child == 0) {
+		snprintf(value, sizeof(value), "%d\n", (int) getpid());
+		if (write_text(CG "/fz/cgroup.procs", value) < 0)
+			_exit(10);
+		for (;;) {
+			int file = open(counter, O_WRONLY | O_CREAT | O_APPEND, 0644);
+			if (file >= 0) {
+				(void) write(file, "x", 1);
+				close(file);
+			}
+			msleep(5);
+		}
+	}
+
+	msleep(100);
+	check(stat(counter, &st) == 0, "stat counter before freeze");
+	before = st.st_size;
+
+	if (write_text(CG "/fz/cgroup.freeze", "1\n") < 0)
+		fail("freeze fz");
+	wait_state(child, true);
+
+	check(stat(counter, &st) == 0, "stat counter while frozen");
+	before = st.st_size;
+	msleep(200);
+	check(stat(counter, &st) == 0, "stat counter while frozen again");
+	after = st.st_size;
+	check(after == before, "frozen process still ran (%lld -> %lld)",
+	      (long long) before, (long long) after);
+
+	{
+		char text[1024];
+		check(read_text(CG "/fz/cgroup.events", text, sizeof(text)) >= 0,
+		      "read frozen events");
+		check(strstr(text, "populated 1") != NULL
+		      && strstr(text, "frozen 1") != NULL,
+		      "events = '%s'", text);
+	}
+
+	errno = 0;
+	expect_error((long) write_text(CG "/fz/cgroup.freeze", "2\n"),
+		     EINVAL, "invalid freeze value");
+
+	if (write_text(CG "/fz/cgroup.freeze", "0\n") < 0)
+		fail("thaw fz");
+	wait_state(child, false);
+	msleep(100);
+	check(stat(counter, &st) == 0, "stat counter after thaw");
+	check(st.st_size > after, "process did not resume after thaw");
+
+	/* A process moved into a frozen cgroup must stop too. */
+	if (write_text(CG "/fz/cgroup.freeze", "1\n") < 0)
+		fail("freeze fz again");
+	wait_state(child, true);
+	moved = fork();
+	if (moved < 0)
+		fail("fork moved");
+	if (moved == 0)
+		for (;;)
+			pause();
+	move_pid("fz", moved);
+	wait_state(moved, true);
+
+	if (write_text(CG "/fz/cgroup.kill", "1\n") < 0)
+		fail("kill frozen fz");
+	waitpid(child, NULL, 0);
+	waitpid(moved, NULL, 0);
+	unlink(counter);
+	remove_group("fz");
+}
