+static void test_subtree_control(void)
+{
+	char text[4096];
+	char value[32];
+	char *trimmed;
+
+	make_group("leaf");
+	make_group("leaf/sub");
+	snprintf(value, sizeof(value), "%d\n", (int) getpid());
+
+	/* The root cgroup is exempt from the no-internal-process rule:
+	 * systemd enables controllers there while PID 1 is still in it.  */
+	if (write_text(CG "/cgroup.subtree_control", "+cpu +memory\n") < 0)
+		fail("enable controllers in populated root");
+	check(read_text(CG "/cgroup.subtree_control", text, sizeof(text)) >= 0,
+	      "read root subtree_control");
+	trimmed = trim(text);
+	check(strcmp(trimmed, "cpu memory") == 0,
+	      "root subtree_control = '%s'", trimmed);
+
+	check(read_text(CG "/leaf/cgroup.controllers", text, sizeof(text)) >= 0,
+	      "read leaf controllers");
+	trimmed = trim(text);
+	check(strcmp(trimmed, "cpu memory") == 0,
+	      "leaf controllers = '%s'", trimmed);
+
+	/* A populated non-root group rejects controller enablement.  */
+	if (write_text(CG "/leaf/cgroup.procs", value) < 0)
+		fail("move self to leaf");
+	errno = 0;
+	expect_error((long) write_text(CG "/leaf/cgroup.subtree_control", "+cpu\n"),
+		     EBUSY, "enable controller in populated non-root group");
+
+	/* Move out of leaf so it has no internal processes.  */
+	if (write_text(CG "/leaf/sub/cgroup.procs", value) < 0)
+		fail("move self to leaf/sub");
+	if (write_text(CG "/leaf/cgroup.subtree_control", "+cpu\n") < 0)
+		fail("enable leaf controller");
+	check(read_text(CG "/leaf/sub/cgroup.controllers", text, sizeof(text)) >= 0,
+	      "read sub controllers");
+	trimmed = trim(text);
+	check(strcmp(trimmed, "cpu") == 0, "sub controllers = '%s'", trimmed);
+
+	errno = 0;
+	expect_error((long) write_text(CG "/cgroup.subtree_control", "+bogus\n"),
+		     ENOENT, "unknown controller");
+
+	if (write_text(CG "/cgroup.procs", value) < 0)
+		fail("move self back to root");
+	remove_group("leaf/sub");
+	remove_group("leaf");
+}
