+static int handle_option_cgroup(Tracee *tracee, const Cli *cli UNUSED, const char *value UNUSED)
+{
+	Extension *extension;
+	Extension *last = NULL;
+	int status;
+
+	/* Initialize the cgroup v2 emulation.  */
+	status = initialize_extension(tracee, cgroup_callback, NULL);
+	if (status < 0) {
+		note(tracee, WARNING, INTERNAL, "cgroup emulation not initialized");
+		return 0;
+	}
+
+	/* Run this extension last so its path rules and its error results
+	 * win over helpers such as fake_id0 (which otherwise turns mknod
+	 * inside cgroupfs into a fake success).  */
+	extension = get_extension(tracee, cgroup_callback);
+	if (extension == NULL)
+		return 0;
+	LIST_FOREACH(last, tracee->extensions, link) {
+		if (LIST_NEXT(last, link) == NULL)
+			break;
+	}
+	if (last != NULL && last != extension) {
+		LIST_REMOVE(extension, link);
+		LIST_INSERT_AFTER(last, extension, link);
+	}
+	return 0;
+}
