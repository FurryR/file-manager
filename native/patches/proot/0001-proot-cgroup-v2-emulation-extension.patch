+/* ------------------------------------------------------------------ */
+/* Small buffers                                                      */
+/* ------------------------------------------------------------------ */
+
+static void buffer_init(struct Buffer *buffer)
+{
+	buffer->data = NULL;
+	buffer->len = 0;
+	buffer->capacity = 0;
+	buffer->failed = false;
+}
+
+static void buffer_free(struct Buffer *buffer)
+{
+	free(buffer->data);
+	buffer_init(buffer);
+}
+
+static void buffer_reserve(struct Buffer *buffer, size_t extra)
+{
+	size_t wanted;
+	char *data;
+
+	if (buffer->failed)
+		return;
+
+	wanted = buffer->len + extra + 1;
+	if (wanted <= buffer->capacity)
+		return;
+
+	if (buffer->capacity == 0)
+		buffer->capacity = 256;
+	while (buffer->capacity < wanted)
+		buffer->capacity *= 2;
+
+	data = realloc(buffer->data, buffer->capacity);
+	if (data == NULL) {
+		buffer->failed = true;
+		return;
+	}
+	buffer->data = data;
+}
+
+static void buffer_appendf(struct Buffer *buffer, const char *format, ...)
+{
+	va_list ap;
+	int length;
+	char *tmp;
+
+	va_start(ap, format);
+	length = vsnprintf(NULL, 0, format, ap);
+	va_end(ap);
+	if (length < 0) {
+		buffer->failed = true;
+		return;
+	}
+
+	buffer_reserve(buffer, (size_t) length);
+	if (buffer->failed)
+		return;
+
+	tmp = buffer->data + buffer->len;
+	va_start(ap, format);
+	vsnprintf(tmp, buffer->capacity - buffer->len, format, ap);
+	va_end(ap);
+	buffer->len += (size_t) length;
+}
+
+static int pid_list_add(struct PidList *list, pid_t pid)
+{
+	pid_t *pids;
+	size_t new_capacity;
+
+	if (list->count == list->capacity) {
+		new_capacity = list->capacity == 0 ? 16 : list->capacity * 2;
+		pids = realloc(list->pids, new_capacity * sizeof(*pids));
+		if (pids == NULL)
+			return -ENOMEM;
+		list->pids = pids;
+		list->capacity = new_capacity;
+	}
+	list->pids[list->count++] = pid;
+	return 0;
+}
+
+static void pid_list_free(struct PidList *list)
+{
+	free(list->pids);
+	list->pids = NULL;
+	list->count = 0;
+	list->capacity = 0;
+}
+
+static int pid_compare(const void *left, const void *right)
+{
+	pid_t a = *(const pid_t *) left;
+	pid_t b = *(const pid_t *) right;
+	return (a > b) - (a < b);
+}
+
+static void pid_list_sort_unique(struct PidList *list)
+{
+	size_t i, out;
+
+	if (list->count < 2)
+		return;
+	qsort(list->pids, list->count, sizeof(*list->pids), pid_compare);
+	out = 1;
+	for (i = 1; i < list->count; i++) {
+		if (list->pids[i] != list->pids[out - 1])
+			list->pids[out++] = list->pids[i];
+	}
+	list->count = out;
+}
