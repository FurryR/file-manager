diff --git a/src/linux/ashmem.h b/src/linux/ashmem.h
new file mode 100644
index 0000000..0473a3d
--- /dev/null
+++ b/src/linux/ashmem.h
@@ -0,0 +1,25 @@
+/* Host fallback for AOSP's <linux/ashmem.h>.
+ *
+ * Termux's PRoot is normally built with the Android NDK, which ships this
+ * header.  Desktop kernels do not, so forward to the system header when
+ * one exists and otherwise provide the few constants PRoot uses.
+ */
+
+#if defined(__has_include_next) && __has_include_next(<linux/ashmem.h>)
+#include_next <linux/ashmem.h>
+#else
+#ifndef _LINUX_ASHMEM_H
+#define _LINUX_ASHMEM_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define ASHMEM_NAME_LEN		256
+#define ASHMEM_NAME_DEF		"dev/ashmem"
+#define ASHMEM_GET_NAME		_IOR('a', 1, char[ASHMEM_NAME_LEN])
+#define ASHMEM_SET_NAME		_IOW('a', 1, char[ASHMEM_NAME_LEN])
+#define ASHMEM_SET_SIZE		_IOW('a', 3, size_t)
+#define ASHMEM_GET_SIZE		_IO('a', 4)
+
+#endif /* _LINUX_ASHMEM_H */
+#endif
diff --git a/src/tracee/event.c b/src/tracee/event.c
