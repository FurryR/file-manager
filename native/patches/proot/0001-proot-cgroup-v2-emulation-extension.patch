+static void test_threads(void)
+{
+	int pipefd[2];
+	pid_t child;
+	pid_t tids[2];
+
+	if (pipe(pipefd) < 0)
+		fail("pipe");
+	make_group("th");
+	make_group("th2");
+
+	child = fork();
+	if (child < 0)
+		fail("fork");
+	if (child == 0) {
+		pthread_t threads[2];
+		pid_t tgid = getpid();
+		char value[64];
+
+		close(pipefd[0]);
+		thread_ids[0] = 0;
+		thread_ids[1] = 0;
+		if (pthread_create(&threads[0], NULL, thread_pause,
+				   (void *) (intptr_t) 0) != 0
+		    || pthread_create(&threads[1], NULL, thread_pause,
+				      (void *) (intptr_t) 1) != 0)
+			_exit(13);
+		while (thread_ids[0] == 0 || thread_ids[1] == 0)
+			usleep(1000);
+		tids[0] = thread_ids[0];
+		tids[1] = thread_ids[1];
+		if (write(pipefd[1], &tgid, sizeof(tgid)) != sizeof(tgid)
+		    || write(pipefd[1], tids, sizeof(tids)) != sizeof(tids))
+			_exit(11);
+
+		snprintf(value, sizeof(value), "%d\n", (int) tgid);
+		if (write_text(CG "/th/cgroup.procs", value) < 0)
+			_exit(12);
+		for (;;)
+			pause();
+	}
+
+	close(pipefd[1]);
+	check(read(pipefd[0], &child, sizeof(child)) == sizeof(child),
+	      "no tgid from thread child");
+	check(read(pipefd[0], tids, sizeof(tids)) == sizeof(tids),
+	      "no thread ids");
+	close(pipefd[0]);
+
+	wait_procs_has("th", child);
+	check(threads_has("th", child), "th threads does not contain main tid");
+	check(threads_has("th", tids[0]) && threads_has("th", tids[1]),
+	      "th threads does not contain both pthread ids");
+	{
+		char path[128];
+		char content[256];
+
+		snprintf(path, sizeof(path), "/proc/%d/task/%d/cgroup",
+			 (int) child, (int) tids[0]);
+		check(read_text(path, content, sizeof(content)) >= 0,
+		      "read thread cgroup");
+		check(strcmp(content, "0::/th\n") == 0,
+		      "thread cgroup = '%s'", content);
+	}
+
+	{
+		char path[512];
+		char value[32];
+		snprintf(path, sizeof(path), "%s/th2/cgroup.threads", CG);
+		snprintf(value, sizeof(value), "%d\n", (int) tids[0]);
+		if (write_text(path, value) < 0)
+			fail("move thread to th2");
+	}
+	check(threads_has("th2", tids[0]), "th2 missing moved thread");
+	check(!threads_has("th", tids[0]), "th still lists moved thread");
+	check(threads_has("th", tids[1]), "th lost sibling thread");
+	check(procs_has("th", child), "th lost process after thread move");
+
+	if (write_text(CG "/th/cgroup.kill", "1\n") < 0
+	    || write_text(CG "/th2/cgroup.kill", "1\n") < 0)
+		fail("kill threaded cgroups");
+	waitpid(child, NULL, 0);
+	remove_group("th");
+	remove_group("th2");
+}
