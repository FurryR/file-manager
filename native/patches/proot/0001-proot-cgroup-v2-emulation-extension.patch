+	fd = openat(dirfd, "cgroup.procs", O_RDONLY | O_CLOEXEC);
+	check(fd >= 0, "reopen cgroup.procs through dirfd");
+	check(read(fd, text, sizeof(text) - 1) > 0, "read cgroup.procs via dirfd");
+	close(fd);
+	check(text_has_pid(text, child), "dirfd move did not take effect");
+
+	fd = openat(dirfd, "cgroup.events", O_RDONLY | O_CLOEXEC);
+	check(fd >= 0, "openat cgroup.events through dirfd");
+	check(read(fd, text, sizeof(text) - 1) > 0, "read cgroup.events via dirfd");
+	close(fd);
+	check(strstr(text, "populated 1") != NULL,
+	      "dirfd event list is not populated: '%s'", text);
+
+	fd = openat(dirfd, "cgroup.kill", O_WRONLY | O_CLOEXEC);
+	check(fd >= 0, "openat cgroup.kill through dirfd");
+	check(write(fd, "1\n", 2) == 2, "write cgroup.kill through dirfd");
+	close(fd);
+	waitpid(child, NULL, 0);
+	wait_dead(child);
+
+	rootfd = open(CG, O_PATH | O_DIRECTORY | O_CLOEXEC);
+	check(rootfd >= 0, "open cgroup root with O_PATH");
+	check(unlinkat(rootfd, "fd", AT_REMOVEDIR) == 0,
+	      "rmdir through O_PATH dirfd");
+	close(rootfd);
+	close(dirfd);
+}
