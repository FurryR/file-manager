+		fail("fork");
+	if (service == 0) {
+		snprintf(value, sizeof(value), "%d\n", (int) getpid());
+		if (write_text(CG "/system.slice/demo.service/cgroup.procs",
+			       value) < 0)
+			_exit(10);
+		for (;;) {
+			int fd = open(counter, O_WRONLY | O_CREAT | O_APPEND, 0644);
+			if (fd >= 0) {
+				(void) write(fd, "x", 1);
+				close(fd);
+			}
+			msleep(5);
+		}
+	}
+
+	msleep(100);
+	check(read_text(CG "/system.slice/demo.service/cgroup.events", text,
+			sizeof(text)) >= 0, "read service events");
+	check(strstr(text, "populated 1") != NULL, "service not populated");
+	check(procs_has("system.slice/demo.service", service),
+	      "service pid not in unit cgroup");
+
+	if (write_text(CG "/system.slice/demo.service/cgroup.freeze", "1\n") < 0)
+		fail("freeze service");
+	wait_state(service, true);
+	check(stat(counter, &st) == 0, "stat service counter");
+	before = st.st_size;
+	msleep(150);
+	check(stat(counter, &st) == 0, "stat service counter again");
+	after = st.st_size;
+	check(before == after, "frozen service kept running");
+
+	if (write_text(CG "/system.slice/demo.service/cgroup.kill", "1\n") < 0)
+		fail("kill service");
+	waitpid(service, NULL, 0);
+	wait_dead(service);
+	check(read_text(CG "/system.slice/demo.service/cgroup.events", text,
+			sizeof(text)) >= 0, "read service events after kill");
+	check(strstr(text, "populated 0") != NULL,
+	      "service still populated after kill");
+
+	remove_group("system.slice/demo.service");
+	remove_group("system.slice");
+	unlink(counter);
+}
+
+static void test_hierarchy_events(void)
+{
+	int pipefd[2];
+	pid_t parent_proc, child_proc;
+	char text[1024];
+
+	if (pipe(pipefd) < 0)
+		fail("pipe");
+	make_group("outer");
+	make_group("outer/inner");
+
+	parent_proc = fork();
+	if (parent_proc < 0)
+		fail("fork");
+	if (parent_proc == 0) {
+		pid_t child;
+		char value[32];
+
+		close(pipefd[0]);
+		snprintf(value, sizeof(value), "%d\n", (int) getpid());
+		if (write_text(CG "/outer/cgroup.procs", value) < 0)
+			_exit(10);
+		child = fork();
+		if (child == 0) {
+			snprintf(value, sizeof(value), "%d\n", (int) getpid());
+			if (write_text(CG "/outer/inner/cgroup.procs", value) < 0)
+				_exit(11);
+			for (;;)
+				pause();
+		}
+		if (write(pipefd[1], &child, sizeof(child)) != sizeof(child))
+			_exit(12);
+		for (;;)
+			pause();
+	}
+
+	close(pipefd[1]);
+	check(read(pipefd[0], &child_proc, sizeof(child_proc))
+	      == sizeof(child_proc), "no nested child pid");
+	close(pipefd[0]);
+	wait_procs_has("outer", parent_proc);
+	wait_procs_has("outer/inner", child_proc);
+
+	check(read_text(CG "/outer/cgroup.events", text, sizeof(text)) >= 0,
+	      "read outer events");
+	check(strstr(text, "populated 1") != NULL, "outer not populated");
+	check(read_text(CG "/outer/inner/cgroup.events", text, sizeof(text)) >= 0,
+	      "read inner events");
+	check(strstr(text, "populated 1") != NULL, "inner not populated");
+
+	if (write_text(CG "/outer/cgroup.freeze", "1\n") < 0)
+		fail("freeze outer");
+	wait_state(parent_proc, true);
+	wait_state(child_proc, true);
+	check(read_text(CG "/outer/inner/cgroup.events", text, sizeof(text)) >= 0,
+	      "read inner events while frozen");
+	check(strstr(text, "frozen 1") != NULL,
+	      "descendant does not inherit frozen state");
+
+	if (write_text(CG "/outer/cgroup.kill", "1\n") < 0)
+		fail("kill outer");
+	waitpid(parent_proc, NULL, 0);
+	wait_dead(child_proc);
+	remove_group("outer/inner");
+	remove_group("outer");
+}
+
+int main(int argc, char **argv)
+{
+	if (argc != 2) {
+		fprintf(stderr, "usage: %s <case>\n", argv[0]);
+		return 2;
+	}
+
+	if (strcmp(argv[1], "root_layout") == 0)
+		test_root_layout();
+	else if (strcmp(argv[1], "mkdir_rmdir") == 0)
+		test_mkdir_rmdir();
+	else if (strcmp(argv[1], "membership_inheritance") == 0)
+		test_membership_inheritance();
+	else if (strcmp(argv[1], "move_process_tree") == 0)
+		test_move_process_tree();
+	else if (strcmp(argv[1], "dirfd_operations") == 0)
+		test_dirfd_operations();
+	else if (strcmp(argv[1], "kill_subtree") == 0)
+		test_kill_subtree();
+	else if (strcmp(argv[1], "freeze_thaw") == 0)
+		test_freeze_thaw();
+	else if (strcmp(argv[1], "threads") == 0)
+		test_threads();
+	else if (strcmp(argv[1], "proc_cgroup_and_mount") == 0)
+		test_proc_cgroup_and_mount();
+	else if (strcmp(argv[1], "subtree_control") == 0)
+		test_subtree_control();
+	else if (strcmp(argv[1], "limits_and_type") == 0)
+		test_limits_and_type();
+	else if (strcmp(argv[1], "events_inotify") == 0)
+		test_events_inotify();
+	else if (strcmp(argv[1], "errors_and_permissions") == 0)
+		test_errors_and_permissions();
+	else if (strcmp(argv[1], "rename_group") == 0)
+		test_rename_group();
+	else if (strcmp(argv[1], "service_manager_flow") == 0)
+		test_service_manager_flow();
+	else if (strcmp(argv[1], "hierarchy_events") == 0)
+		test_hierarchy_events();
+	else {
+		fprintf(stderr, "unknown case: %s\n", argv[1]);
+		return 2;
+	}
+
+	printf("PASS: %s\n", argv[1]);
+	return 0;
+}
diff --git a/tests/cgroup/run.sh b/tests/cgroup/run.sh
new file mode 100755
index 0000000..4ce7a29
--- /dev/null
+++ b/tests/cgroup/run.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+# Build and run the --cgroup behaviour tests.
+set -u
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+TEST_DIR="$ROOT/tests/cgroup"
+BIN="$TEST_DIR/cgroup_test"
+
+make -C "$ROOT/src" -j"$(nproc)" || exit 1
+
+cc -O2 -g -Wall -Wextra -pthread -o "$BIN" "$TEST_DIR/cgroup_test.c" || exit 1
+
+TMP="$(mktemp -d "${TMPDIR:-/tmp}/proot-cgroup-tests.XXXXXX")" || exit 1
+trap 'rm -rf "$TMP"' EXIT
+
+CASES=(
+  root_layout
+  mkdir_rmdir
+  membership_inheritance
+  move_process_tree
+  dirfd_operations
+  kill_subtree
+  freeze_thaw
+  threads
+  proc_cgroup_and_mount
+  subtree_control
+  limits_and_type
+  events_inotify
+  errors_and_permissions
+  rename_group
+  service_manager_flow
+  hierarchy_events
+)
+
+failed=0
+for case in "${CASES[@]}"; do
+  export PROOT_TMP_DIR="$TMP/proot-$case"
+  mkdir -p "$PROOT_TMP_DIR"
+  log="$TMP/$case.log"
+  printf '==> %s\n' "$case"
+  if timeout --kill-after=5 90 "$ROOT/src/proot" -0 --cgroup -r / -w / \
+      "$BIN" "$case" \
+      >"$log" 2>&1; then
+    tail -n 1 "$log"
+  else
+    printf 'FAIL: %s\n' "$case"
+    cat "$log"
+    failed=$((failed + 1))
+  fi
+done
+
+if [[ "$failed" -ne 0 ]]; then
+  printf '\n%d test case(s) failed\n' "$failed"
+  exit 1
+fi
+printf '\nall %d cgroup test cases passed\n' "${#CASES[@]}"
