+/* ------------------------------------------------------------------ */
+/* Path helpers                                                       */
+/* ------------------------------------------------------------------ */
+
+static bool path_within(const char *path, const char *prefix)
+{
+	size_t length;
+
+	if (strcmp(prefix, "/") == 0)
+		return path[0] == '/';
+
+	length = strlen(prefix);
+	if (strncmp(path, prefix, length) != 0)
+		return false;
+	return path[length] == '\0' || path[length] == '/';
+}
+
+static bool path_is_strict_descendant(const char *path, const char *prefix)
+{
+	return strcmp(path, prefix) != 0 && path_within(path, prefix);
+}
+
+static int normalize_path(const char *input, char output[PATH_MAX])
+{
+	char copy[PATH_MAX];
+	char *parts[PATH_MAX / 2];
+	size_t part_count = 0;
+	char *token;
+	char *save;
+	size_t length = 1;
+
+	if (input == NULL || input[0] != '/')
+		return -EINVAL;
+	if (strlen(input) >= sizeof(copy))
+		return -ENAMETOOLONG;
+	strcpy(copy, input);
+
+	for (token = strtok_r(copy, "/", &save);
+	     token != NULL;
+	     token = strtok_r(NULL, "/", &save)) {
+		if (strcmp(token, ".") == 0 || token[0] == '\0')
+			continue;
+		if (strcmp(token, "..") == 0) {
+			if (part_count > 0)
+				part_count--;
+			continue;
+		}
+		if (part_count >= sizeof(parts) / sizeof(parts[0]))
+			return -ENAMETOOLONG;
+		parts[part_count++] = token;
+	}
+
+	output[0] = '/';
+	output[1] = '\0';
+	for (size_t i = 0; i < part_count; i++) {
+		length += strlen(parts[i]) + (i == 0 ? 0 : 1);
+		if (length >= PATH_MAX)
+			return -ENAMETOOLONG;
+		if (i != 0)
+			strcat(output, "/");
+		strcat(output, parts[i]);
+	}
+	return 0;
+}
+
+static int join_guest_path(const char *base, const char *user,
+			char output[PATH_MAX])
+{
+	char joined[PATH_MAX];
+	char normalized[PATH_MAX];
+	int status;
+
+	if (user[0] == '/') {
+		if (strlen(user) >= sizeof(joined))
+			return -ENAMETOOLONG;
+		strcpy(joined, user);
+	}
+	else {
+		status = join_paths(2, joined, base, user);
+		if (status < 0)
+			return status;
+	}
+	status = normalize_path(joined, normalized);
+	if (status < 0)
+		return status;
+	strcpy(output, normalized);
+	return 0;
+}
+
+static int parent_path(const char *path, char output[PATH_MAX])
+{
+	char copy[PATH_MAX];
+	char *slash;
+
+	if (strcmp(path, "/") == 0)
+		return -1;
+	if (strlen(path) >= sizeof(copy))
+		return -ENAMETOOLONG;
+	strcpy(copy, path);
+	slash = strrchr(copy, '/');
+	if (slash == NULL)
+		return -EINVAL;
+	if (slash == copy) {
+		output[0] = '/';
+		output[1] = '\0';
+	}
+	else {
+		*slash = '\0';
+		strcpy(output, copy);
+	}
+	return 0;
+}
+
+static unsigned int path_depth(const char *path)
+{
+	unsigned int depth = 0;
+	const char *cursor;
+
+	if (strcmp(path, "/") == 0)
+		return 0;
+	for (cursor = path; *cursor != '\0'; cursor++) {
+		if (*cursor == '/')
+			depth++;
+	}
+	return depth;
+}
+
+static void path_basename(const char *path, char output[PATH_MAX])
+{
+	const char *slash = strrchr(path, '/');
+
+	if (slash == NULL)
+		strcpy(output, path);
+	else
+		strcpy(output, slash + 1);
+}
+
+static void path_dirname(const char *path, char output[PATH_MAX])
+{
+	char copy[PATH_MAX];
+	char *slash;
+
+	strcpy(copy, path);
+	slash = strrchr(copy, '/');
+	if (slash == NULL) {
+		strcpy(output, ".");
+		return;
+	}
+	if (slash == copy) {
+		output[0] = '/';
+		output[1] = '\0';
+		return;
+	}
+	*slash = '\0';
+	strcpy(output, copy);
+}
+
+static int host_path_in_root(const char *root, const char *path,
+			char output[PATH_MAX])
+{
+	int length;
+
+	if (strcmp(path, "/") == 0)
+		length = snprintf(output, PATH_MAX, "%s", root);
+	else
+		length = snprintf(output, PATH_MAX, "%s%s", root, path);
+	if (length < 0 || length >= PATH_MAX)
+		return -ENAMETOOLONG;
+	return 0;
+}
+
+static int group_host_path(struct CgroupConfig *config, const char *path,
+			char output[PATH_MAX])
+{
+	return host_path_in_root(config->root, path, output);
+}
+
+static bool host_to_group(struct CgroupConfig *config, const char *host,
+			char output[PATH_MAX])
+{
+	struct CgroupAlias *alias;
+
+	LIST_FOREACH(alias, &config->aliases, link) {
+		size_t length;
+
+		if (alias->host_root == NULL)
+			continue;
+		length = strlen(alias->host_root);
+		if (strcmp(host, alias->host_root) == 0) {
+			strcpy(output, "/");
+			return true;
+		}
+		if (strncmp(host, alias->host_root, length) != 0
+		    || host[length] != '/')
+			continue;
+		if (strlen(host + length) >= PATH_MAX)
+			return false;
+		strcpy(output, host + length);
+		return true;
+	}
+	return false;
+}
+
+static bool host_is_virtual(struct CgroupConfig *config, const char *host)
+{
+	char group[PATH_MAX];
+
+	return host_to_group(config, host, group);
+}
+
+static struct CgroupAlias *find_alias(struct CgroupConfig *config,
+				const char *guest)
+{
+	struct CgroupAlias *alias;
+	struct CgroupAlias *best = NULL;
+	size_t best_length = 0;
+
+	LIST_FOREACH(alias, &config->aliases, link) {
+		size_t length;
+
+		if (!path_within(guest, alias->path))
+			continue;
+		length = strlen(alias->path);
+		if (length >= best_length) {
+			best = alias;
+			best_length = length;
+		}
+	}
+	return best;
+}
+
+static int alias_add(struct CgroupConfig *config, const char *path,
+		bool permanent, bool cgroup2, const char *host_root)
+{
+	struct CgroupAlias *alias;
+	char normalized[PATH_MAX];
+
+	if (normalize_path(path, normalized) < 0)
+		return -EINVAL;
+
+	LIST_FOREACH(alias, &config->aliases, link) {
+		if (strcmp(alias->path, normalized) == 0) {
+			alias->permanent |= permanent;
+			alias->cgroup2 |= cgroup2;
+			return 0;
+		}
+	}
+
+	alias = talloc_zero(config, struct CgroupAlias);
+	if (alias == NULL)
+		return -ENOMEM;
+	alias->path = talloc_strdup(alias, normalized);
+	if (alias->path == NULL)
+		return -ENOMEM;
+	alias->host_root = talloc_strdup(alias,
+					host_root != NULL ? host_root : config->root);
+	if (alias->host_root == NULL)
+		return -ENOMEM;
+	alias->permanent = permanent;
+	alias->cgroup2 = cgroup2;
+	LIST_INSERT_HEAD(&config->aliases, alias, link);
+	return 0;
+}
+
+static int guest_to_host(struct CgroupConfig *config, const char *guest,
+			char host[PATH_MAX], char group[PATH_MAX])
+{
+	struct CgroupAlias *alias = find_alias(config, guest);
+	const char *suffix;
+
+	if (alias == NULL)
+		return -1;
+
+	suffix = guest + strlen(alias->path);
+	if (*suffix == '\0')
+		strcpy(group, "/");
+	else
+		strcpy(group, suffix);
+
+	return host_path_in_root(alias->host_root != NULL
+				 ? alias->host_root : config->root,
+				 group, host);
+}
+
+/* ------------------------------------------------------------------ */
+/* /proc/<pid>/stat information                                       */
+/* ------------------------------------------------------------------ */
+
+static int read_proc_stat(pid_t pid, struct ProcStat *stat)
+{
+	char path[64];
+	char buffer[1024];
+	char *paren;
+	char *cursor;
+	char *save;
+	char *token;
+	ssize_t length;
+	int fd;
+	int index;
+
+	snprintf(path, sizeof(path), "/proc/%d/stat", (int) pid);
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+	length = read(fd, buffer, sizeof(buffer) - 1);
+	close(fd);
+	if (length <= 0)
+		return length == 0 ? -ESRCH : -errno;
+	buffer[length] = '\0';
+
+	/* The comm field may contain spaces and parentheses.  */
+	paren = strrchr(buffer, ')');
+	if (paren == NULL)
+		return -EINVAL;
+	cursor = paren + 1;
+	while (*cursor == ' ')
+		cursor++;
+
+	token = strtok_r(cursor, " ", &save);
+	if (token == NULL)
+		return -EINVAL;
+	stat->state = token[0];
+
+	stat->ppid = 0;
+	stat->pgrp = 0;
+	stat->sid = 0;
+	stat->starttime = 0;
+
+	for (index = 1; index <= 19; index++) {
+		token = strtok_r(NULL, " ", &save);
+		if (token == NULL)
+			return -EINVAL;
+		switch (index) {
+		case 1:
+			stat->ppid = (pid_t) strtol(token, NULL, 10);
+			break;
+		case 2:
+			stat->pgrp = (pid_t) strtol(token, NULL, 10);
+			break;
+		case 3:
+			stat->sid = (pid_t) strtol(token, NULL, 10);
+			break;
+		case 19:
+			stat->starttime = strtoull(token, NULL, 10);
+			break;
+		default:
+			break;
+		}
+	}
+	return 0;
+}
+
+static pid_t proc_tgid(pid_t pid)
+{
+	char path[64];
+	char buffer[4096];
+	char *cursor;
+	ssize_t length;
+	int fd;
+	pid_t tgid = pid;
+
+	snprintf(path, sizeof(path), "/proc/%d/status", (int) pid);
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return pid;
+	length = read(fd, buffer, sizeof(buffer) - 1);
+	close(fd);
+	if (length <= 0)
+		return pid;
+	buffer[length] = '\0';
+
+	cursor = buffer;
+	while (cursor != NULL && *cursor != '\0') {
+		if (strncmp(cursor, "Tgid:", 5) == 0) {
+			tgid = (pid_t) strtol(cursor + 5, NULL, 10);
+			break;
+		}
+		cursor = strchr(cursor, '\n');
+		if (cursor != NULL)
+			cursor++;
+	}
+	return tgid;
+}
+
+/* ------------------------------------------------------------------ */
+/* Groups                                                             */
+/* ------------------------------------------------------------------ */
+
+static struct CgroupGroup *group_find(struct CgroupConfig *config,
+				const char *path)
+{
+	struct CgroupGroup *group;
+
+	LIST_FOREACH(group, &config->groups, link) {
+		if (strcmp(group->path, path) == 0)
+			return group;
+	}
+	return NULL;
+}
+
+static struct CgroupGroup *group_get(struct CgroupConfig *config,
+				const char *path)
+{
+	struct CgroupGroup *group = group_find(config, path);
+
+	if (group != NULL)
+		return group;
+
+	group = talloc_zero(config, struct CgroupGroup);
+	if (group == NULL)
+		return NULL;
+	group->path = talloc_strdup(group, path);
+	if (group->path == NULL)
+		return NULL;
+	group->max_depth = UINT_MAX;
+	group->max_descendants = UINT_MAX;
+	LIST_INSERT_HEAD(&config->groups, group, link);
+	return group;
+}
+
+static void group_drop(struct CgroupConfig *config UNUSED, struct CgroupGroup *group)
+{
+	LIST_REMOVE(group, link);
+	talloc_free(group);
+}
+
+static bool group_has_children(struct CgroupConfig *config, const char *path)
+{
+	struct CgroupGroup *group;
+
+	LIST_FOREACH(group, &config->groups, link) {
+		if (path_is_strict_descendant(group->path, path))
+			return true;
+	}
+	return false;
+}
+
+static unsigned int controllers_for_group(struct CgroupConfig *config,
+					struct CgroupGroup *group)
+{
+	char parent[PATH_MAX];
+	struct CgroupGroup *parent_group;
+
+	if (strcmp(group->path, "/") == 0)
+		return CG_ALL_CONTROLLERS;
+	if (parent_path(group->path, parent) < 0)
+		return 0;
+	parent_group = group_find(config, parent);
+	if (parent_group == NULL)
+		return 0;
+	return parent_group->subtree_control;
+}
+
+static void controllers_to_string(unsigned int mask, char output[256])
+{
+	size_t offset = 0;
+	size_t i;
+
+	output[0] = '\0';
+	for (i = 0; i < sizeof(controllers) / sizeof(controllers[0]); i++) {
+		int written;
+
+		if ((mask & controllers[i].bit) == 0)
+			continue;
+		written = snprintf(output + offset, 256 - offset, "%s%s",
+				offset == 0 ? "" : " ", controllers[i].name);
+		if (written < 0 || (size_t) written >= 256 - offset)
+			break;
+		offset += (size_t) written;
+	}
+}
+
+static int controller_bit(const char *name, unsigned int *bit)
+{
+	size_t i;
+
+	for (i = 0; i < sizeof(controllers) / sizeof(controllers[0]); i++) {
+		if (strcmp(controllers[i].name, name) == 0) {
+			*bit = controllers[i].bit;
+			return 0;
+		}
+	}
+	return -ENOENT;
+}
+
+/* ------------------------------------------------------------------ */
+/* Processes                                                          */
+/* ------------------------------------------------------------------ */
+
+static struct CgroupProc *proc_find(struct CgroupConfig *config, pid_t pid)
+{
+	struct CgroupProc *proc;
+
+	LIST_FOREACH(proc, &config->procs, link) {
+		if (proc->pid == pid)
+			return proc;
+	}
+	return NULL;
+}
+
+static bool proc_is_alive(struct CgroupProc *proc)
+{
+	struct ProcStat stat;
+
+	if (read_proc_stat(proc->pid, &stat) < 0)
+		return false;
+	if (stat.state == 'Z' || stat.state == 'X')
+		return false;
+	if (proc->starttime != 0 && stat.starttime != proc->starttime)
+		return false;
+	return true;
+}
+
+static struct CgroupProc *proc_get(struct CgroupConfig *config, pid_t pid)
+{
+	struct CgroupProc *proc = proc_find(config, pid);
+
+	if (proc != NULL)
+		return proc;
+	proc = talloc_zero(config, struct CgroupProc);
+	if (proc == NULL)
+		return NULL;
+	proc->pid = pid;
+	proc->tgid = pid;
+	LIST_INSERT_HEAD(&config->procs, proc, link);
+	return proc;
+}
+
+static void proc_drop(struct CgroupConfig *config UNUSED, struct CgroupProc *proc)
+{
+	LIST_REMOVE(proc, link);
+	talloc_free(proc);
+}
+
+static void events_content(struct CgroupConfig *config,
+			struct CgroupGroup *group, struct Buffer *buffer);
+
+static void write_file_at(const char *directory, const char *name,
+			const char *content, mode_t mode)
+{
+	char path[PATH_MAX];
+	int fd;
+
+	if (snprintf(path, PATH_MAX, "%s/%s", directory, name) >= PATH_MAX)
+		return;
+	/* Pseudo-files such as cgroup.events are read-only in the final
+	 * view; temporarily make them writable for the emulator itself.  */
+	(void) chmod(path, 0600);
+	fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+	if (fd < 0)
+		return;
+	if (content != NULL) {
+		size_t length = strlen(content);
+		ssize_t ignored = write(fd, content, length);
+		(void) ignored;
+	}
+	close(fd);
+	chmod(path, mode);
+}
+
+static void touch_events(struct CgroupConfig *config, const char *path)
+{
+	char current[PATH_MAX];
+	struct CgroupGroup *group;
+
+	if (path == NULL || path[0] != '/')
+		return;
+	strcpy(current, path);
+	while (true) {
+		struct Buffer buffer;
+
+		group = group_find(config, current);
+		if (group != NULL) {
+			char directory[PATH_MAX];
+
+			if (group_host_path(config, current, directory) == 0) {
+				buffer_init(&buffer);
+				events_content(config, group, &buffer);
+				if (!buffer.failed)
+					write_file_at(directory, "cgroup.events",
+						     buffer.data, 0444);
+				buffer_free(&buffer);
+			}
+		}
+		if (strcmp(current, "/") == 0)
+			break;
+		if (parent_path(current, current) < 0)
+			break;
+	}
+}
+
+static int proc_set(struct CgroupConfig *config, pid_t pid, const char *path,
+		bool thread, pid_t tgid)
+{
+	struct CgroupProc *proc;
+	struct ProcStat stat;
+	char old_path[PATH_MAX];
+	bool had_old = false;
+	int status;
+
+	proc = proc_find(config, pid);
+	if (proc != NULL) {
+		strcpy(old_path, proc->path != NULL ? proc->path : "/");
+		had_old = true;
+	}
+	else {
+		proc = proc_get(config, pid);
+		if (proc == NULL)
+			return -ENOMEM;
+	}
+
+	status = read_proc_stat(pid, &stat);
+	if (status == 0) {
+		proc->starttime = stat.starttime;
+		proc->ppid = stat.ppid;
+		proc->pgrp = stat.pgrp;
+		proc->sid = stat.sid;
+	}
+	else {
+		proc->starttime = 0;
+		proc->ppid = 0;
+		proc->pgrp = 0;
+		proc->sid = 0;
+	}
+
+	/* PRoot's clone event does not carry CLONE_THREAD, so ask /proc
+	 * whether this pid is a thread and which thread group owns it.  */
+	{
+		pid_t actual_tgid = proc_tgid(pid);
+		if (actual_tgid > 0 && actual_tgid != pid) {
+			thread = true;
+			tgid = actual_tgid;
+		}
+		else if (!thread) {
+			tgid = pid;
+		}
+	}
+
+	if (proc->path != NULL)
+		talloc_free(proc->path);
+	proc->path = talloc_strdup(proc, path);
+	if (proc->path == NULL)
+		return -ENOMEM;
+	proc->thread = thread;
+	proc->tgid = tgid;
+
+	if (had_old && strcmp(old_path, path) != 0)
+		touch_events(config, old_path);
+	touch_events(config, path);
+	return 0;
+}
+
+static bool ensure_self(Tracee *tracee, struct CgroupConfig *config)
+{
+	char path[PATH_MAX];
+	struct CgroupProc *proc;
+
+	/* The initial Tracee object still carries the tracer's pid while the
+	 * child is being launched; it is not part of the container.  */
+	if (tracee->pid <= 0 || tracee->pid == getpid())
+		return false;
+
+	if (config->root_pid == 0) {
+		config->root_pid = tracee->pid;
+		(void) proc_set(config, tracee->pid, "/", false, tracee->pid);
+		return true;
+	}
+
+	proc = proc_find(config, tracee->pid);
+	if (proc != NULL && proc_is_alive(proc))
+		return false;
+
+	/* The tracee is older than this PRoot launch (or a thread whose
+	 * inherit event was missed).  It still belongs to the container.  */
+	strcpy(path, "/");
+	(void) proc_set(config, tracee->pid, path, false, tracee->pid);
+	return true;
+}
+
+/*
+ * cgroup membership for @pid.  The tracee map is authoritative; the ppid
+ * walk and the session/process-group match are the unprivileged recovery
+ * path for a process whose fork event happened outside PRoot's view (or
+ * whose parent already exited).  Only tracees are considered, so host
+ * processes are never attributed to the container.
+ */
+static int proc_path(Tracee *tracee, struct CgroupConfig *config, pid_t pid,
+		char output[PATH_MAX])
+{
+	struct CgroupProc *proc;
+	struct ProcStat stat;
+	pid_t cursor;
+	int depth;
+
+	proc = proc_find(config, pid);
+	if (proc != NULL && proc->path != NULL) {
+		if (proc_is_alive(proc)) {
+			strcpy(output, proc->path);
+			return 0;
+		}
+		proc_drop(config, proc);
+	}
+
+	if (read_proc_stat(pid, &stat) < 0)
+		return -ESRCH;
+
+	if (pid == config->root_pid) {
+		strcpy(output, "/");
+		return 0;
+	}
+
+	cursor = stat.ppid;
+	for (depth = 0; cursor > 1 && depth < 4096; depth++) {
+		struct ProcStat parent_stat;
+
+		proc = proc_find(config, cursor);
+		if (proc != NULL && proc->path != NULL && proc_is_alive(proc)) {
+			strcpy(output, proc->path);
+			return 0;
+		}
+		if (read_proc_stat(cursor, &parent_stat) < 0)
+			break;
+		cursor = parent_stat.ppid;
+	}
+
+	if (get_tracee(tracee, pid, false) == NULL)
+		return -ESRCH;
+
+	/* An orphan reparented to a subreaper keeps its session or process
+	 * group even when its parent chain no longer reaches a tracee.  */
+	LIST_FOREACH(proc, &config->procs, link) {
+		if (proc->path == NULL || !proc_is_alive(proc))
+			continue;
+		if (proc->sid == stat.sid || proc->pgrp == stat.pgrp) {
+			strcpy(output, proc->path);
+			return 0;
+		}
+	}
+
+	strcpy(output, "/");
+	return 0;
+}
+
+static bool path_is_frozen(struct CgroupConfig *config, const char *path)
+{
+	char current[PATH_MAX];
+	struct CgroupGroup *group;
+
+	if (path == NULL)
+		return false;
+	strcpy(current, path);
+	while (true) {
+		group = group_find(config, current);
+		if (group != NULL && group->frozen)
+			return true;
+		if (strcmp(current, "/") == 0)
+			break;
+		if (parent_path(current, current) < 0)
+			break;
+	}
+	return false;
+}
+
+static void signal_proc(struct CgroupProc *proc, int signal)
+{
+	if (proc->thread)
+		(void) syscall(SYS_tgkill, proc->tgid, proc->pid, signal);
+	else
+		(void) kill(proc->pid, signal);
+}
+
+/*
+ * Mark the tracee stopped in PRoot's event loop before SIGSTOP arrives.
+ * SIGSTOP is not enough by itself: PRoot's tracer must leave the tracee
+ * in its ptrace-stop, otherwise it restarts it on the next loop turn.
+ */
+static void freeze_one(Tracee *context, struct CgroupProc *proc, bool freeze)
+{
+	Tracee *target = get_tracee(context, proc->pid, false);
+
+	if (target != NULL)
+		target->cgroup_frozen = freeze;
+
+	if (freeze) {
+		signal_proc(proc, SIGSTOP);
+		return;
+	}
+
+	if (target == NULL) {
+		signal_proc(proc, SIGCONT);
+		return;
+	}
+
+	if (!target->running) {
+		target->restart_how = PTRACE_SYSCALL;
+		(void) restart_tracee(target, SIGCONT);
+	}
+	else {
+		signal_proc(proc, SIGCONT);
+	}
+}
+
+static void signal_group(Tracee *context, struct CgroupConfig *config,
+			const char *path, bool freeze)
+{
+	struct CgroupProc *proc;
+
+	LIST_FOREACH(proc, &config->procs, link) {
+		if (proc->path == NULL || !path_within(proc->path, path))
+			continue;
+		if (!freeze && path_is_frozen(config, proc->path))
+			continue;
+		freeze_one(context, proc, freeze);
+	}
+}
+
+static void kill_group(struct CgroupConfig *config, const char *path)
+{
+	int round;
+
+	for (round = 0; round < KILL_ROUNDS; round++) {
+		struct CgroupProc *proc;
+		bool any = false;
+
+		LIST_FOREACH(proc, &config->procs, link) {
+			if (proc->path == NULL || !path_within(proc->path, path))
+				continue;
+			if (!proc_is_alive(proc))
+				continue;
+			any = true;
+			signal_proc(proc, SIGKILL);
+		}
+		if (!any)
+			return;
+		usleep(1000);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* File contents                                                      */
+/* ------------------------------------------------------------------ */
+
+static enum CgroupFile file_kind(const char *name)
+{
+	if (strcmp(name, "cgroup.procs") == 0)
+		return CG_PROCS;
+	if (strcmp(name, "cgroup.threads") == 0)
+		return CG_THREADS;
+	if (strcmp(name, "cgroup.kill") == 0)
+		return CG_KILL;
+	if (strcmp(name, "cgroup.freeze") == 0)
+		return CG_FREEZE;
+	if (strcmp(name, "cgroup.events") == 0)
+		return CG_EVENTS;
+	if (strcmp(name, "cgroup.controllers") == 0)
+		return CG_CONTROLLERS;
+	if (strcmp(name, "cgroup.subtree_control") == 0)
+		return CG_SUBTREE_CONTROL;
+	if (strcmp(name, "cgroup.stat") == 0)
+		return CG_STAT;
+	if (strcmp(name, "cgroup.max.depth") == 0)
+		return CG_MAX_DEPTH;
+	if (strcmp(name, "cgroup.max.descendants") == 0)
+		return CG_MAX_DESCENDANTS;
+	if (strcmp(name, "cgroup.type") == 0)
+		return CG_TYPE;
+	if (strcmp(name, "cgroup.pressure") == 0)
+		return CG_PRESSURE;
+	if (strcmp(name, "cgroup.available") == 0)
+		return CG_AVAILABLE;
+	return CG_NONE;
+}
+
+static mode_t file_mode(enum CgroupFile kind)
+{
+	switch (kind) {
+	case CG_KILL:
+		return 0200;
+	case CG_EVENTS:
+	case CG_CONTROLLERS:
+	case CG_STAT:
+	case CG_PRESSURE:
+	case CG_AVAILABLE:
+		return 0444;
+	default:
+		return 0644;
+	}
+}
+
+static void collect_procs(struct CgroupConfig *config, const char *path,
+			bool threads, struct PidList *list)
+{
+	struct CgroupProc *proc;
+
+	/* Managed processes and threads are the authoritative set.  The
+	 * ppid/sid walk below only covers a tracee whose inherit event was
+	 * missed (for example a process PRoot started before attaching). */
+	LIST_FOREACH(proc, &config->procs, link) {
+		pid_t tgid;
+
+		if (proc->path == NULL || strcmp(proc->path, path) != 0)
+			continue;
+		if (!proc_is_alive(proc))
+			continue;
+		if (!threads && proc->thread)
+			continue;
+
+		if (!threads) {
+			(void) pid_list_add(list, proc->pid);
+			continue;
+		}
+
+		if (proc->thread) {
+			(void) pid_list_add(list, proc->pid);
+			continue;
+		}
+
+		/* A process member contributes all of its threads unless a
+		 * thread was explicitly moved to another cgroup.  */
+		{
+			char task_dir[64];
+			DIR *dir;
+			struct dirent *entry;
+
+			tgid = proc->pid;
+			snprintf(task_dir, sizeof(task_dir), "/proc/%d/task", (int) tgid);
+			dir = opendir(task_dir);
+			if (dir == NULL) {
+				(void) pid_list_add(list, tgid);
+				continue;
+			}
+			while ((entry = readdir(dir)) != NULL) {
+				char *end;
+				long tid;
+
+				if (entry->d_name[0] == '.')
+					continue;
+				errno = 0;
+				tid = strtol(entry->d_name, &end, 10);
+				if (errno != 0 || *end != '\0' || tid <= 0)
+					continue;
+				{
+					struct CgroupProc *thread = proc_find(config, (pid_t) tid);
+					if (thread != NULL && thread->thread
+					    && thread->path != NULL
+					    && strcmp(thread->path, path) != 0)
+						continue;
+				}
+				(void) pid_list_add(list, (pid_t) tid);
+			}
+			closedir(dir);
+		}
+	}
+
+	/* Include an explicitly moved thread whose owning process is in a
+	 * different cgroup.  */
+	if (threads) {
+		LIST_FOREACH(proc, &config->procs, link) {
+			if (proc->thread && proc->path != NULL
+			    && strcmp(proc->path, path) == 0
+			    && proc_is_alive(proc))
+				(void) pid_list_add(list, proc->pid);
+		}
+	}
+
+	pid_list_sort_unique(list);
+}
+
+static void procs_content(struct CgroupConfig *config, const char *path,
+			bool threads, struct Buffer *buffer)
+{
+	struct PidList list = { 0 };
+	size_t i;
+
+	collect_procs(config, path, threads, &list);
+	for (i = 0; i < list.count; i++)
+		buffer_appendf(buffer, "%d\n", (int) list.pids[i]);
+	pid_list_free(&list);
+}
+
+static bool group_is_populated(struct CgroupConfig *config, const char *path)
+{
+	struct CgroupProc *proc;
+
+	LIST_FOREACH(proc, &config->procs, link) {
+		if (proc->path == NULL || !path_within(proc->path, path))
+			continue;
+		if (proc_is_alive(proc))
+			return true;
+	}
+	return false;
+}
+
+static unsigned int group_descendants(struct CgroupConfig *config,
+				const char *path)
+{
+	struct CgroupGroup *group;
+	unsigned int count = 0;
+
+	LIST_FOREACH(group, &config->groups, link) {
+		if (path_is_strict_descendant(group->path, path))
+			count++;
+	}
+	return count;
+}
+
+static void events_content(struct CgroupConfig *config,
+			struct CgroupGroup *group, struct Buffer *buffer)
+{
+	buffer_appendf(buffer, "populated %d\n",
+		      group_is_populated(config, group->path) ? 1 : 0);
+	buffer_appendf(buffer, "frozen %d\n",
+		      path_is_frozen(config, group->path) ? 1 : 0);
+}
+
+static void group_file_content(struct CgroupConfig *config,
+			struct CgroupGroup *group, enum CgroupFile kind,
+			struct Buffer *buffer)
+{
+	char controllers_string[256];
+
+	switch (kind) {
+	case CG_PROCS:
+		procs_content(config, group->path, false, buffer);
+		break;
+	case CG_THREADS:
+		procs_content(config, group->path, true, buffer);
+		break;
+	case CG_FREEZE:
+		buffer_appendf(buffer, "%d\n", group->frozen ? 1 : 0);
+		break;
+	case CG_EVENTS:
+		events_content(config, group, buffer);
+		break;
+	case CG_CONTROLLERS:
+		controllers_to_string(controllers_for_group(config, group),
+				     controllers_string);
+		buffer_appendf(buffer, "%s\n", controllers_string);
+		break;
+	case CG_SUBTREE_CONTROL:
+		controllers_to_string(group->subtree_control, controllers_string);
+		buffer_appendf(buffer, "%s\n", controllers_string);
+		break;
+	case CG_STAT:
+		buffer_appendf(buffer, "nr_descendants %u\n",
+			      group_descendants(config, group->path));
+		buffer_appendf(buffer, "nr_dying_descendants 0\n");
+		break;
+	case CG_MAX_DEPTH:
+		if (group->max_depth == UINT_MAX)
+			buffer_appendf(buffer, "max\n");
+		else
+			buffer_appendf(buffer, "%u\n", group->max_depth);
+		break;
+	case CG_MAX_DESCENDANTS:
+		if (group->max_descendants == UINT_MAX)
+			buffer_appendf(buffer, "max\n");
+		else
+			buffer_appendf(buffer, "%u\n", group->max_descendants);
+		break;
+	case CG_TYPE:
+		buffer_appendf(buffer, "%s\n", group->threaded ? "threaded" : "domain");
+		break;
+	case CG_PRESSURE:
+		buffer_appendf(buffer, "some avg10=0.00 avg60=0.00 avg300=0.00 total=0\n");
+		buffer_appendf(buffer, "full avg10=0.00 avg60=0.00 avg300=0.00 total=0\n");
+		break;
+	case CG_AVAILABLE:
+		buffer_appendf(buffer, "1\n");
+		break;
+	case CG_KILL:
+	case CG_NONE:
+		break;
+	}
+}
+
+static void populate_group(struct CgroupConfig *config, const char *path)
+{
+	static const struct {
+		const char *name;
+		enum CgroupFile kind;
+	} files[] = {
+		{ "cgroup.procs",		CG_PROCS },
+		{ "cgroup.threads",		CG_THREADS },
+		{ "cgroup.kill",		CG_KILL },
+		{ "cgroup.freeze",		CG_FREEZE },
+		{ "cgroup.events",		CG_EVENTS },
+		{ "cgroup.controllers",		CG_CONTROLLERS },
+		{ "cgroup.subtree_control",	CG_SUBTREE_CONTROL },
+		{ "cgroup.stat",		CG_STAT },
+		{ "cgroup.max.depth",		CG_MAX_DEPTH },
+		{ "cgroup.max.descendants",	CG_MAX_DESCENDANTS },
+		{ "cgroup.type",		CG_TYPE },
+		{ "cgroup.pressure",		CG_PRESSURE },
+		{ "cgroup.available",		CG_AVAILABLE },
+	};
+	char directory[PATH_MAX];
+	size_t i;
+
+	if (group_host_path(config, path, directory) < 0)
+		return;
+
+	for (i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+		char file[PATH_MAX];
+		int fd;
+
+		if (snprintf(file, PATH_MAX, "%s/%s", directory, files[i].name)
+		    >= PATH_MAX)
+			continue;
+		/* Create writable so touch_events() can seed the values;
+		 * the final mode is applied below.  */
+		fd = open(file, O_WRONLY | O_CREAT, 0600);
+		if (fd >= 0)
+			close(fd);
+	}
+
+	touch_events(config, path);
+
+	for (i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+		char file[PATH_MAX];
+
+		if (snprintf(file, PATH_MAX, "%s/%s", directory, files[i].name)
+		    >= PATH_MAX)
+			continue;
+		chmod(file, file_mode(files[i].kind));
+	}
+}
+
+static bool open_is_readable(Tracee *tracee)
+{
+	word_t sysnum = get_sysnum(tracee, CURRENT);
+	word_t flags;
+
+	switch (sysnum) {
+	case PR_open:
+		flags = peek_reg(tracee, CURRENT, SYSARG_2);
+		break;
+	case PR_openat:
+		flags = peek_reg(tracee, CURRENT, SYSARG_3);
+		break;
+	case PR_creat:
+		return false;
+	default:
+		return true;
+	}
+
+	if ((flags & O_ACCMODE) == O_WRONLY)
+		return false;
+	if ((flags & O_PATH) != 0)
+		return false;
+	return true;
+}
+
+static bool open_creates(Tracee *tracee)
+{
+	word_t sysnum = get_sysnum(tracee, CURRENT);
+	word_t flags;
+
+	switch (sysnum) {
+	case PR_open:
+		flags = peek_reg(tracee, CURRENT, SYSARG_2);
+		break;
+	case PR_openat:
+		flags = peek_reg(tracee, CURRENT, SYSARG_3);
+		break;
+	case PR_creat:
+		return true;
+	default:
+		return false;
+	}
+	return (flags & O_CREAT) != 0;
+}
+
+static int check_growth_limits(struct CgroupConfig *config, const char *path)
+{
+	char ancestor[PATH_MAX];
+	struct CgroupGroup *group;
+	int depth = (int) path_depth(path);
+
+	strcpy(ancestor, path);
+	while (parent_path(ancestor, ancestor) == 0) {
+		group = group_find(config, ancestor);
+		if (group != NULL) {
+			if (group->max_depth != UINT_MAX
+			    && depth - (int) path_depth(ancestor)
+			       > (int) group->max_depth)
+				return -ENOENT;
+			if (group->max_descendants != UINT_MAX
+			    && group_descendants(config, ancestor)
+			       >= group->max_descendants)
+				return -ENOSPC;
+		}
+		if (strcmp(ancestor, "/") == 0)
+			break;
+	}
+	return 0;
+}
+
+static int prepare_virtual_path(Tracee *tracee, struct CgroupConfig *config,
+				const char *host)
+{
+	char name[PATH_MAX];
+	char directory[PATH_MAX];
+	char group_path[PATH_MAX];
+	struct CgroupGroup *group;
+	struct stat st;
+	enum CgroupFile kind;
+	bool readable;
+	int fd;
+
+	/* Only cgroupfs-created objects exist here; arbitrary inodes are
+	 * not allowed.  */
+	switch (get_sysnum(tracee, CURRENT)) {
+	case PR_mknod:
+	case PR_mknodat:
+	case PR_symlink:
+	case PR_symlinkat:
+	case PR_link:
+	case PR_linkat:
+		return -EPERM;
+	case PR_truncate:
+	case PR_truncate64:
+		return -EINVAL;
+	default:
+		break;
+	}
+
+	path_basename(host, name);
+	path_dirname(host, directory);
+	kind = file_kind(name);
+	readable = open_is_readable(tracee);
+
+	if (stat(host, &st) == 0) {
+		if (S_ISDIR(st.st_mode)) {
+			if (!host_to_group(config, host, group_path))
+				return 0;
+			(void) group_get(config, group_path);
+			return 0;
+		}
+		if (kind != CG_NONE) {
+			if (readable && kind != CG_KILL) {
+				struct Buffer buffer;
+
+				if (!host_to_group(config, directory, group_path))
+					return 0;
+				group = group_get(config, group_path);
+				if (group == NULL)
+					return -ENOMEM;
+				buffer_init(&buffer);
+				group_file_content(config, group, kind, &buffer);
+				if (!buffer.failed)
+					write_file_at(directory, name, buffer.data,
+						      file_mode(kind));
+				buffer_free(&buffer);
+			}
+			chmod(host, file_mode(kind));
+			return 0;
+		}
+		return 0;
+	}
+
+	if (kind != CG_NONE) {
+		struct Buffer buffer;
+
+		if (stat(directory, &st) < 0 || !S_ISDIR(st.st_mode))
+			return -ENOENT;
+		if (!host_to_group(config, directory, group_path))
+			return -EINVAL;
+		group = group_get(config, group_path);
+		if (group == NULL)
+			return -ENOMEM;
+
+		fd = open(host, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+		if (fd < 0 && errno != EEXIST)
+			return -errno;
+		if (fd >= 0)
+			close(fd);
+
+		if (readable && kind != CG_KILL) {
+			buffer_init(&buffer);
+			group_file_content(config, group, kind, &buffer);
+			if (!buffer.failed)
+				write_file_at(directory, name, buffer.data,
+					      file_mode(kind));
+			buffer_free(&buffer);
+		}
+		chmod(host, file_mode(kind));
+		return 0;
+	}
+
+	/* cgroupfs is a pseudo-filesystem: arbitrary files and symlinks
+	 * cannot be created there.  */
+	if (open_creates(tracee))
+		return -EACCES;
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* /proc synthesis                                                    */
+/* ------------------------------------------------------------------ */
+
+static int make_proc_cgroup(Tracee *tracee, struct CgroupConfig *config,
+			pid_t pid, char result[PATH_MAX])
+{
+	char path[PATH_MAX];
+	const char *temporary;
+	FILE *file;
+
+	if (pid <= 0)
+		return -ESRCH;
+	if (proc_path(tracee, config, pid, path) < 0)
+		return -ESRCH;
+
+	temporary = create_temp_file(tracee->ctx, "cgroup-proc");
+	if (temporary == NULL)
+		return -ENOMEM;
+	file = fopen(temporary, "w");
+	if (file == NULL)
+		return -ENOMEM;
+	fprintf(file, "0::%s\n", path);
+	fclose(file);
+	if (strlen(temporary) >= PATH_MAX)
+		return -ENAMETOOLONG;
+	strcpy(result, temporary);
+	return 1;
+}
+
+static int maybe_proc_file(Tracee *tracee, struct CgroupConfig *config,
+			char result[PATH_MAX], const char *user_path)
+{
+	char guest[PATH_MAX];
+	char *cursor;
+	int status;
+
+	if (result[0] == '/' && host_is_virtual(config, result))
+		return 0;
+
+	status = join_guest_path(result, user_path, guest);
+	if (status < 0)
+		return 0;
+
+	if (strcmp(guest, "/proc/cgroups") == 0) {
+		const char *temporary;
+		FILE *file;
+		size_t i;
+
+		if (!open_is_readable(tracee))
+			return -EACCES;
+		temporary = create_temp_file(tracee->ctx, "proc-cgroups");
+		if (temporary == NULL)
+			return -ENOMEM;
+		file = fopen(temporary, "w");
+		if (file == NULL)
+			return -ENOMEM;
+		fprintf(file, "#subsys_name\thierarchy\tnum_cgroups\tenabled\n");
+		for (i = 0; i < sizeof(controllers) / sizeof(controllers[0]); i++)
+			fprintf(file, "%s\t0\t1\t1\n", controllers[i].name);
+		fclose(file);
+		if (strlen(temporary) >= PATH_MAX)
+			return -ENAMETOOLONG;
+		strcpy(result, temporary);
+		return 1;
+	}
+
+	if (strcmp(guest, "/proc/self/cgroup") == 0
+	    || strcmp(guest, "/proc/thread-self/cgroup") == 0)
+		return make_proc_cgroup(tracee, config, tracee->pid, result);
+
+	if (strncmp(guest, "/proc/", 6) != 0)
+		return 0;
+
+	cursor = guest + 6;
+	if (strncmp(cursor, "self/", 5) == 0 || strncmp(cursor, "thread-self/", 12) == 0)
+		return 0;
+
+	{
+		char *end;
+		long pid;
+		long tid = 0;
+
+		errno = 0;
+		pid = strtol(cursor, &end, 10);
+		if (errno != 0 || end == cursor || pid <= 0 || pid > INT_MAX)
+			return 0;
+
+		if (strcmp(end, "/cgroup") == 0) {
+			if (!open_is_readable(tracee))
+				return -EACCES;
+			return make_proc_cgroup(tracee, config, (pid_t) pid, result);
+		}
+
+		if (strncmp(end, "/task/", 6) != 0)
+			return 0;
+		cursor = end + 6;
+		errno = 0;
+		tid = strtol(cursor, &end, 10);
+		if (errno != 0 || end == cursor || strcmp(end, "/cgroup") != 0)
+			return 0;
+		if (tid <= 0 || tid > INT_MAX)
+			return 0;
+		if (!open_is_readable(tracee))
+			return -EACCES;
+		return make_proc_cgroup(tracee, config, (pid_t) tid, result);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Path translation                                                   */
+/* ------------------------------------------------------------------ */
+
+static int handle_guest_path(Tracee *tracee, struct CgroupConfig *config,
+			char *result, const char *user_path)
+{
+	char guest[PATH_MAX];
+	char host[PATH_MAX];
+	char group[PATH_MAX];
+	int status;
+
+	(void) ensure_self(tracee, config);
+
+	status = maybe_proc_file(tracee, config, result, user_path);
+	if (status != 0)
+		return status;
+
+	if (result[0] == '/' && host_is_virtual(config, result)) {
+		char normalized[PATH_MAX];
+
+		if (user_path[0] == '/') {
+			if (strlen(user_path) >= sizeof(host))
+				return -ENAMETOOLONG;
+			strcpy(host, user_path);
+		}
+		else {
+			status = join_paths(2, host, result, user_path);
+			if (status < 0)
+				return status;
+		}
+		/* A relative ".." from a cgroup directory must not escape
+		 * the synthetic hierarchy.  */
+		status = normalize_path(host, normalized);
+		if (status < 0)
+			return -EACCES;
+		if (!host_is_virtual(config, normalized))
+			return -EACCES;
+		strcpy(host, normalized);
+	}
+	else {
+		status = join_guest_path(result, user_path, guest);
+		if (status < 0)
+			return 0;
+		if (find_alias(config, guest) == NULL)
+			return 0;
+		status = guest_to_host(config, guest, host, group);
+		if (status < 0)
+			return 0;
+	}
+
+	(void) group;
+	status = prepare_virtual_path(tracee, config, host);
+	if (status < 0)
+		return status;
+	if (strlen(host) >= PATH_MAX)
+		return -ENAMETOOLONG;
+	strcpy(result, host);
+	return 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Syscall handlers                                                   */
+/* ------------------------------------------------------------------ */
+
+static int resolve_host_path(Tracee *tracee, int dirfd, word_t path_argument,
+			char host[PATH_MAX], char guest[PATH_MAX])
+{
+	char user[PATH_MAX];
+	int status;
+
+	status = read_path(tracee, user, path_argument);
+	if (status < 0)
+		return status;
+	status = translate_path(tracee, host, dirfd, user, true);
+	if (status < 0)
+		return status;
+	if (guest != NULL) {
+		status = join_guest_path("/", user, guest);
+		if (status < 0)
+			return status;
+	}
+	return 0;
+}
+
+static int reject_syscall(Tracee *tracee, int error)
+{
+	poke_reg(tracee, SYSARG_RESULT, (word_t) error);
+	set_sysnum(tracee, PR_void);
+	return 1;
+}
+
+static int handle_mkdir(Tracee *tracee, struct CgroupConfig *config,
+			int dirfd, word_t path_argument)
+{
+	char host[PATH_MAX];
+	char group[PATH_MAX];
+	char parent[PATH_MAX];
+	char group_parent[PATH_MAX];
+	struct stat st;
+	int status;
+
+	status = resolve_host_path(tracee, dirfd, path_argument, host, NULL);
+	if (status < 0)
+		return status;
+	if (!host_to_group(config, host, group))
+		return 0;
+
+	if (strcmp(group, "/") == 0)
+		return -EEXIST;
+	if (stat(host, &st) == 0)
+		return -EEXIST;
+	if (stat(config->root, &st) < 0 || !S_ISDIR(st.st_mode))
+		return -ENOENT;
+	path_dirname(host, parent);
+	if (stat(parent, &st) < 0 || !S_ISDIR(st.st_mode))
+		return -ENOENT;
+
+	if (parent_path(group, group_parent) == 0
+	    && group_find(config, group_parent) == NULL)
+		return -ENOENT;
+	status = check_growth_limits(config, group);
+	if (status < 0)
+		return status;
+
+	status = mkdir(host, 0755);
+	if (status < 0)
+		return -errno;
+
+	(void) group_get(config, group);
+	populate_group(config, group);
+	touch_events(config, group_parent);
+	poke_reg(tracee, SYSARG_RESULT, 0);
+	set_sysnum(tracee, PR_void);
+	return 1;
+}
+
+static int remove_group_files(const char *host)
+{
+	DIR *dir;
+	struct dirent *entry;
+	int result = 0;
+
+	dir = opendir(host);
+	if (dir == NULL)
+		return -errno;
+
+	while ((entry = readdir(dir)) != NULL) {
+		char path[PATH_MAX];
+		struct stat st;
+
+		if (strcmp(entry->d_name, ".") == 0
+		    || strcmp(entry->d_name, "..") == 0)
+			continue;
+		if (snprintf(path, PATH_MAX, "%s/%s", host, entry->d_name)
+		    >= PATH_MAX) {
+			result = -ENAMETOOLONG;
+			break;
+		}
+		if (lstat(path, &st) < 0) {
+			result = -errno;
+			break;
+		}
+		if (S_ISDIR(st.st_mode)) {
+			result = -ENOTEMPTY;
+			break;
+		}
+		if (unlink(path) < 0) {
+			result = -errno;
+			break;
+		}
+	}
+	closedir(dir);
+	return result;
+}
+
+static bool group_has_members(struct CgroupConfig *config, const char *path)
+{
+	struct CgroupProc *proc;
+
+	LIST_FOREACH(proc, &config->procs, link) {
+		if (proc->path != NULL && strcmp(proc->path, path) == 0
+		    && proc_is_alive(proc))
+			return true;
+	}
+	return false;
+}
+
+static int handle_rmdir(Tracee *tracee, struct CgroupConfig *config,
+			int dirfd, word_t path_argument)
+{
+	char host[PATH_MAX];
+	char group[PATH_MAX];
+	char parent[PATH_MAX];
+	struct CgroupGroup *group_entry;
+	struct stat st;
+	int status;
+
+	status = resolve_host_path(tracee, dirfd, path_argument, host, NULL);
+	if (status < 0)
+		return status;
+	if (!host_to_group(config, host, group))
+		return 0;
+
+	if (strcmp(group, "/") == 0)
+		return -EBUSY;
+	group_entry = group_find(config, group);
+	if (group_entry == NULL)
+		return -ENOENT;
+	if (stat(host, &st) < 0)
+		return -errno;
+	if (!S_ISDIR(st.st_mode))
+		return -ENOTDIR;
+	if (group_has_children(config, group))
+		return -ENOTEMPTY;
+	if (group_has_members(config, group))
+		return -EBUSY;
+
+	status = remove_group_files(host);
+	if (status < 0)
+		return status;
+	status = rmdir(host);
+	if (status < 0)
+		return -errno;
+
+	touch_events(config, group);
+	if (parent_path(group, parent) == 0)
+		touch_events(config, parent);
+	group_drop(config, group_entry);
+	poke_reg(tracee, SYSARG_RESULT, 0);
+	set_sysnum(tracee, PR_void);
+	return 1;
+}
+
+static int handle_unlink(Tracee *tracee, struct CgroupConfig *config,
+			int dirfd, word_t path_argument, bool remove_dir)
+{
+	char host[PATH_MAX];
+	char group[PATH_MAX];
+	int status;
+
+	status = resolve_host_path(tracee, dirfd, path_argument, host, NULL);
+	if (status < 0)
+		return status;
+	if (!host_to_group(config, host, group))
+		return 0;
+	if (remove_dir)
+		return handle_rmdir(tracee, config, dirfd, path_argument);
+
+	/* cgroupfs pseudo-files cannot be unlinked.  */
+	return -EPERM;
+}
+
+static int handle_rename(Tracee *tracee, struct CgroupConfig *config,
+			int old_dirfd, word_t old_argument,
+			int new_dirfd, word_t new_argument)
+{
+	char old_host[PATH_MAX];
+	char new_host[PATH_MAX];
+	char old_group[PATH_MAX];
+	char new_group[PATH_MAX];
+	char parent[PATH_MAX];
+	struct CgroupGroup *group;
+	struct CgroupProc *proc;
+	struct stat st;
+	int status;
+
+	status = resolve_host_path(tracee, old_dirfd, old_argument, old_host, NULL);
+	if (status < 0)
+		return status;
+	status = resolve_host_path(tracee, new_dirfd, new_argument, new_host, NULL);
+	if (status < 0)
+		return status;
+
+	if (!host_to_group(config, old_host, old_group)
+	    && !host_to_group(config, new_host, new_group))
+		return 0;
+	if (!host_to_group(config, old_host, old_group)
+	    || !host_to_group(config, new_host, new_group))
+		return -EXDEV;
+	if (strcmp(old_group, "/") == 0)
+		return -EBUSY;
+
+	group = group_find(config, old_group);
+	if (group == NULL)
+		return -ENOENT;
+	if (stat(new_host, &st) == 0)
+		return -EEXIST;
+	path_dirname(new_host, parent);
+	if (stat(parent, &st) < 0 || !S_ISDIR(st.st_mode))
+		return -ENOENT;
+
+	status = rename(old_host, new_host);
+	if (status < 0)
+		return -errno;
+
+	/* Reparent the bookkeeping record, all descendant groups and every
+	 * process below the renamed cgroup.  */
+	{
+		struct CgroupGroup *other;
+		size_t old_length = strlen(old_group);
+
+		LIST_FOREACH(other, &config->groups, link) {
+			char updated[PATH_MAX];
+
+			if (other == group
+			    || !path_is_strict_descendant(other->path, old_group))
+				continue;
+			snprintf(updated, sizeof(updated), "%s%s", new_group,
+				 other->path + old_length);
+			talloc_free(other->path);
+			other->path = talloc_strdup(other, updated);
+			if (other->path == NULL)
+				return -ENOMEM;
+		}
+
+		talloc_free(group->path);
+		group->path = talloc_strdup(group, new_group);
+		if (group->path == NULL)
+			return -ENOMEM;
+
+		LIST_FOREACH(proc, &config->procs, link) {
+			char updated[PATH_MAX];
+
+			if (proc->path == NULL || !path_within(proc->path, old_group))
+				continue;
+			snprintf(updated, sizeof(updated), "%s%s", new_group,
+				 proc->path + old_length);
+			talloc_free(proc->path);
+			proc->path = talloc_strdup(proc, updated);
+			if (proc->path == NULL)
+				return -ENOMEM;
+		}
+	}
+
+	touch_events(config, old_group);
+	touch_events(config, new_group);
+	poke_reg(tracee, SYSARG_RESULT, 0);
+	set_sysnum(tracee, PR_void);
+	return 1;
+}
+
+static int parse_pid_list(const char *data, pid_t *pids, size_t capacity,
+			size_t *count)
+{
+	char copy[65536];
+	char *save;
+	char *token;
+	size_t found = 0;
+
+	if (strlen(data) >= sizeof(copy))
+		return -EINVAL;
+	strcpy(copy, data);
+
+	for (token = strtok_r(copy, " \t\r\n", &save);
+	     token != NULL;
+	     token = strtok_r(NULL, " \t\r\n", &save)) {
+		char *end;
+		long value;
+
+		errno = 0;
+		value = strtol(token, &end, 10);
+		if (errno != 0 || *end != '\0' || value <= 0
+		    || value > INT_MAX)
+			return -EINVAL;
+		if (found >= capacity)
+			return -E2BIG;
+		pids[found++] = (pid_t) value;
+	}
+	if (found == 0)
+		return -EINVAL;
+	*count = found;
+	return 0;
+}
+
+static int move_one(Tracee *tracee, struct CgroupConfig *config, pid_t pid,
+		const char *path, bool thread_file)
+{
+	pid_t tgid;
+	struct ProcStat stat;
+	struct CgroupProc *proc;
+	int status;
+
+	status = read_proc_stat(pid, &stat);
+	if (status < 0)
+		return -ESRCH;
+
+	tgid = proc_tgid(pid);
+	if (!thread_file || tgid == pid) {
+		struct CgroupProc *thread;
+		struct CgroupProc *next;
+
+		/* cgroup.procs migrates the whole thread group; update
+		 * threads before the leader so cgroup.threads is complete as
+		 * soon as cgroup.procs shows the process.  */
+		for (thread = LIST_FIRST(&config->procs);
+		     thread != NULL;
+		     thread = next) {
+			next = LIST_NEXT(thread, link);
+			if (thread->thread && thread->tgid == tgid)
+				(void) proc_set(config, thread->pid, path, true, tgid);
+		}
+		status = proc_set(config, tgid, path, false, tgid);
+		if (status < 0)
+			return status;
+	}
+	else {
+		status = proc_set(config, pid, path, true, tgid);
+		if (status < 0)
+			return status;
+	}
+
+	if (path_is_frozen(config, path)) {
+		proc = proc_find(config, thread_file ? pid : tgid);
+		if (proc != NULL)
+			freeze_one(tracee, proc, true);
+	}
+	return 0;
+}
+
+static int apply_procs_write(Tracee *tracee, struct CgroupConfig *config,
+			const char *group, bool threads,
+			const char *data, size_t length)
+{
+	pid_t pids[4096];
+	size_t count = 0;
+	size_t i;
+	int status;
+	char copy[65536];
+
+	if (length >= sizeof(copy))
+		return -EINVAL;
+	memcpy(copy, data, length);
+	copy[length] = '\0';
+	status = parse_pid_list(copy, pids, sizeof(pids) / sizeof(pids[0]),
+				&count);
+	if (status < 0)
+		return status;
+
+	for (i = 0; i < count; i++) {
+		status = move_one(tracee, config, pids[i], group, threads);
+		if (status < 0)
+			return status;
+	}
+	return 0;
+}
+
+static int apply_subtree_control(struct CgroupConfig *config,
+			struct CgroupGroup *group, const char *data,
+			size_t length)
+{
+	char copy[65536];
+	char *save;
+	char *token;
+	unsigned int mask = group->subtree_control;
+	unsigned int adding = 0;
+	unsigned int removing = 0;
+
+	if (length >= sizeof(copy))
+		return -EINVAL;
+	memcpy(copy, data, length);
+	copy[length] = '\0';
+
+	for (token = strtok_r(copy, " \t\r\n", &save);
+	     token != NULL;
+	     token = strtok_r(NULL, " \t\r\n", &save)) {
+		bool add;
+		unsigned int bit;
+		int status;
+
+		if (token[0] == '+')
+			add = true;
+		else if (token[0] == '-')
+			add = false;
+		else
+			return -EINVAL;
+		status = controller_bit(token + 1, &bit);
+		if (status < 0)
+			return status;
+		if ((controllers_for_group(config, group) & bit) == 0)
+			return -ENOENT;
+		if (add)
+			adding |= bit;
+		else
+			removing |= bit;
+	}
+
+	/* The root cgroup is exempt from the no-internal-process rule;
+	 * systemd enables controllers there while PID 1 is still a member.  */
+	if (adding != 0 && strcmp(group->path, "/") != 0
+	    && group_has_members(config, group->path))
+		return -EBUSY;
+	group->subtree_control = (mask | adding) & ~removing;
+	touch_events(config, group->path);
+	return 0;
+}
+
+static int apply_write(Tracee *tracee, struct CgroupConfig *config,
+			const char *group_path, const char *name,
+			const char *data, size_t length)
+{
+	struct CgroupGroup *group = group_find(config, group_path);
+	enum CgroupFile kind = file_kind(name);
+	char copy[65536];
+	int status;
+
+	if (group == NULL)
+		return -ENOENT;
+	if (kind == CG_NONE)
+		return -EPERM;
+
+	switch (kind) {
+	case CG_PROCS:
+		status = apply_procs_write(tracee, config, group_path, false,
+					   data, length);
+		break;
+	case CG_THREADS:
+		status = apply_procs_write(tracee, config, group_path, true,
+					   data, length);
+		break;
+	case CG_KILL:
+		if (length >= sizeof(copy))
+			return -EINVAL;
+		memcpy(copy, data, length);
+		copy[length] = '\0';
+		{
+			char *save;
+			char *token = strtok_r(copy, " \t\r\n", &save);
+			if (token == NULL || strcmp(token, "1") != 0
+			    || strtok_r(NULL, " \t\r\n", &save) != NULL)
+				return -EINVAL;
+		}
+		kill_group(config, group_path);
+		status = 0;
+		break;
+	case CG_FREEZE:
+		if (length >= sizeof(copy))
+			return -EINVAL;
+		memcpy(copy, data, length);
+		copy[length] = '\0';
+		{
+			char *save;
+			char *token = strtok_r(copy, " \t\r\n", &save);
+			if (token == NULL || strtok_r(NULL, " \t\r\n", &save) != NULL)
+				return -EINVAL;
+			if (strcmp(token, "1") == 0) {
+				group->frozen = true;
+				signal_group(tracee, config, group_path, true);
+			}
+			else if (strcmp(token, "0") == 0) {
+				group->frozen = false;
+				signal_group(tracee, config, group_path, false);
+			}
+			else {
+				return -EINVAL;
+			}
+		}
+		touch_events(config, group_path);
+		status = 0;
+		break;
+	case CG_SUBTREE_CONTROL:
+		status = apply_subtree_control(config, group, data, length);
+		break;
+	case CG_MAX_DEPTH:
+	case CG_MAX_DESCENDANTS: {
+		unsigned int value;
+		if (length >= sizeof(copy))
+			return -EINVAL;
+		memcpy(copy, data, length);
+		copy[length] = '\0';
+		{
+			char *save;
+			char *token = strtok_r(copy, " \t\r\n", &save);
+			if (token == NULL || strtok_r(NULL, " \t\r\n", &save) != NULL)
+				return -EINVAL;
+			if (strcmp(token, "max") == 0) {
+				value = UINT_MAX;
+			}
+			else {
+				char *end;
+				unsigned long parsed;
+				errno = 0;
+				parsed = strtoul(token, &end, 10);
+				if (errno != 0 || *end != '\0' || parsed > UINT_MAX)
+					return -EINVAL;
+				value = (unsigned int) parsed;
+			}
+		}
+		if (kind == CG_MAX_DEPTH) {
+			if (value != UINT_MAX && group_descendants(config, group->path) > 0) {
+				struct CgroupGroup *child;
+				unsigned int deepest = 0;
+
+				LIST_FOREACH(child, &config->groups, link) {
+					if (!path_is_strict_descendant(child->path,
+								       group->path))
+						continue;
+					if (path_depth(child->path)
+					    - path_depth(group->path) > deepest)
+						deepest = path_depth(child->path)
+							- path_depth(group->path);
+				}
+				if (deepest > value)
+					return -EBUSY;
+			}
+			group->max_depth = value;
+		}
+		else {
+			if (value != UINT_MAX
+			    && group_descendants(config, group->path) > value)
+				return -EBUSY;
+			group->max_descendants = value;
+		}
+		status = 0;
+		break;
+	}
+	case CG_TYPE: {
+		if (length >= sizeof(copy))
+			return -EINVAL;
+		memcpy(copy, data, length);
+		copy[length] = '\0';
+		{
+			char *save;
+			char *token = strtok_r(copy, " \t\r\n", &save);
+			if (token == NULL || strtok_r(NULL, " \t\r\n", &save) != NULL)
+				return -EINVAL;
+			if (strcmp(token, "domain") == 0)
+				group->threaded = false;
+			else if (strcmp(token, "threaded") == 0)
+				group->threaded = true;
+			else
+				return -EINVAL;
+		}
+		status = 0;
+		break;
+	}
+	default:
+		/* cgroup.events, cgroup.stat, cgroup.controllers and the
+		 * resource-free read-only files cannot be written.  */
+		status = -EPERM;
+		break;
+	}
+	return status;
+}
+
+static int read_fd_target(Tracee *tracee, int fd, char path[PATH_MAX])
+{
+	return readlink_proc_pid_fd(tracee->pid, fd, path);
+}
+
+static int read_write_data(Tracee *tracee, word_t address, size_t size,
+			char buffer[65536], size_t *length)
+{
+	if (size > 65535)
+		size = 65535;
+	if (read_data(tracee, buffer, address, size) < 0)
+		return -EFAULT;
+	buffer[size] = '\0';
+	*length = size;
+	return 0;
+}
+
+static int read_writev_data(Tracee *tracee, word_t iovec_address,
+			size_t count, char buffer[65536], size_t *length)
+{
+	struct iovec iovec[64];
+	size_t offset = 0;
+	size_t i;
+	int status;
+
+	if (count > sizeof(iovec) / sizeof(iovec[0]))
+		count = sizeof(iovec) / sizeof(iovec[0]);
+	status = read_data(tracee, iovec, iovec_address,
+			   count * sizeof(iovec[0]));
+	if (status < 0)
+		return -EFAULT;
+
+	for (i = 0; i < count && offset < 65535; i++) {
+		size_t chunk = iovec[i].iov_len;
+
+		if (chunk > 65535 - offset)
+			chunk = 65535 - offset;
+		if (chunk == 0)
+			continue;
+		status = read_data(tracee, buffer + offset, (word_t) iovec[i].iov_base,
+				   chunk);
+		if (status < 0)
+			return -EFAULT;
+		offset += chunk;
+	}
+	buffer[offset] = '\0';
+	*length = offset;
+	return 0;
+}
+
+static int handle_write(Tracee *tracee, struct CgroupConfig *config)
+{
+	word_t sysnum = get_sysnum(tracee, ORIGINAL);
+	int fd;
+	char path[PATH_MAX];
+	char directory[PATH_MAX];
+	char group[PATH_MAX];
+	char name[PATH_MAX];
+	char data[65536];
+	size_t length = 0;
+	int status;
+
+	switch (sysnum) {
+	case PR_write:
+	case PR_pwrite64:
+		fd = (int) peek_reg(tracee, CURRENT, SYSARG_1);
+		status = read_write_data(tracee,
+				peek_reg(tracee, CURRENT, SYSARG_2),
+				(size_t) peek_reg(tracee, CURRENT, SYSARG_3),
+				data, &length);
+		break;
+	case PR_writev:
+	case PR_pwritev:
+	case PR_pwritev2:
+		fd = (int) peek_reg(tracee, CURRENT, SYSARG_1);
+		status = read_writev_data(tracee,
+				peek_reg(tracee, CURRENT, SYSARG_2),
+				(size_t) peek_reg(tracee, CURRENT, SYSARG_3),
+				data, &length);
+		break;
+	default:
+		return 0;
+	}
+	if (status < 0)
+		return 0;
+
+	status = read_fd_target(tracee, fd, path);
+	if (status < 0)
+		return 0;
+	if (!host_is_virtual(config, path))
+		return 0;
+
+	path_dirname(path, directory);
+	path_basename(path, name);
+	if (!host_to_group(config, directory, group))
+		return 0;
+	return apply_write(tracee, config, group, name, data, length);
+}
+
+static int handle_mount(Tracee *tracee, struct CgroupConfig *config)
+{
+	char source[PATH_MAX];
+	char target[PATH_MAX];
+	char fstype[PATH_MAX];
+	char guest[PATH_MAX];
+	char cwd[PATH_MAX];
+	int status;
+
+	status = read_path(tracee, source, peek_reg(tracee, CURRENT, SYSARG_1));
+	if (status < 0)
+		return 0;
+	(void) source;
+	status = read_path(tracee, target, peek_reg(tracee, CURRENT, SYSARG_2));
+	if (status < 0)
+		return 0;
+	status = read_path(tracee, fstype, peek_reg(tracee, CURRENT, SYSARG_3));
+	if (status < 0)
+		return 0;
+
+	if (strcmp(fstype, "cgroup") == 0)
+		return -ENODEV;
+	if (strcmp(fstype, "cgroup2") != 0)
+		return 0;
+
+	if (target[0] == '/') {
+		strcpy(guest, target);
+	}
+	else {
+		if (getcwd2(tracee, cwd) < 0)
+			return -ENOENT;
+		status = join_guest_path(cwd, target, guest);
+		if (status < 0)
+			return status;
+	}
+	status = normalize_path(guest, guest);
+	if (status < 0)
+		return status;
+
+	status = alias_add(config, guest, false, true, NULL);
+	if (status < 0)
+		return status;
+	poke_reg(tracee, SYSARG_RESULT, 0);
+	set_sysnum(tracee, PR_void);
+	return 1;
+}
+
+static int handle_umount(Tracee *tracee, struct CgroupConfig *config)
+{
+	char target[PATH_MAX];
+	char guest[PATH_MAX];
+	char cwd[PATH_MAX];
+	struct CgroupAlias *alias;
+	int status;
+
+	status = read_path(tracee, target, peek_reg(tracee, CURRENT, SYSARG_1));
+	if (status < 0)
+		return 0;
+	if (target[0] == '/') {
+		strcpy(guest, target);
+	}
+	else {
+		if (getcwd2(tracee, cwd) < 0)
+			return 0;
+		if (join_guest_path(cwd, target, guest) < 0)
+			return 0;
+	}
+	if (normalize_path(guest, guest) < 0)
+		return 0;
+
+	LIST_FOREACH(alias, &config->aliases, link) {
+		if (strcmp(alias->path, guest) != 0)
+			continue;
+		if (!alias->permanent) {
+			LIST_REMOVE(alias, link);
+			talloc_free(alias);
+		}
+		poke_reg(tracee, SYSARG_RESULT, 0);
+		set_sysnum(tracee, PR_void);
+		return 1;
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* statfs                                                             */
+/* ------------------------------------------------------------------ */
+
+static bool fd_is_virtual(Tracee *tracee, struct CgroupConfig *config, int fd)
+{
+	char path[PATH_MAX];
+
+	if (read_fd_target(tracee, fd, path) < 0)
+		return false;
+	return strncmp(path, config->root, strlen(config->root)) == 0
+	       && (path[strlen(config->root)] == '\0'
+		   || path[strlen(config->root)] == '/');
+}
+
+static void fake_statfs_magic(Tracee *tracee, word_t address)
+{
+	uint32_t magic = CGROUP2_SUPER_MAGIC;
+	(void) write_data(tracee, address, &magic, sizeof(magic));
+}
+
+static bool path_argument_is_virtual(Tracee *tracee, struct CgroupConfig *config,
+				word_t address)
+{
+	char path[PATH_MAX];
+	char host[PATH_MAX];
+	char group[PATH_MAX];
+
+	if (read_path(tracee, path, address) < 0)
+		return false;
+	if (strncmp(path, config->root, strlen(config->root)) == 0
+	    && (path[strlen(config->root)] == '\0'
+		|| path[strlen(config->root)] == '/'))
+		return true;
+	return path[0] == '/' && guest_to_host(config, path, host, group) == 0;
+}
+
+/*
+ * fake_id0 turns mknod/symlink/link into fake successes even when the
+ * cgroup path was rejected at syscall entry.  Re-assert the cgroupfs
+ * rule at exit so those pseudo-files cannot be created under --root-id.
+ */
+static int enforce_cgroup_exit(Tracee *tracee, struct CgroupConfig *config)
+{
+	word_t sysnum = get_sysnum(tracee, ORIGINAL);
+	bool virtual = false;
+	int error = -EPERM;
+
+	switch (sysnum) {
+	case PR_mknod:
+		virtual = path_argument_is_virtual(tracee, config,
+						   peek_reg(tracee, ORIGINAL, SYSARG_1));
+		break;
+	case PR_mknodat:
+		virtual = path_argument_is_virtual(tracee, config,
+						   peek_reg(tracee, ORIGINAL, SYSARG_2));
+		break;
+	case PR_symlink:
+		virtual = path_argument_is_virtual(tracee, config,
+						   peek_reg(tracee, ORIGINAL, SYSARG_2));
+		break;
+	case PR_symlinkat:
+		virtual = path_argument_is_virtual(tracee, config,
+						   peek_reg(tracee, ORIGINAL, SYSARG_3));
+		break;
+	case PR_link:
+		virtual = path_argument_is_virtual(tracee, config,
+						   peek_reg(tracee, ORIGINAL, SYSARG_2));
+		break;
+	case PR_linkat:
+		virtual = path_argument_is_virtual(tracee, config,
+						   peek_reg(tracee, ORIGINAL, SYSARG_4));
+		break;
+	case PR_truncate:
+	case PR_truncate64:
+		virtual = path_argument_is_virtual(tracee, config,
+						   peek_reg(tracee, ORIGINAL, SYSARG_1));
+		error = -EINVAL;
+		break;
+	default:
+		return 0;
+	}
+
+	if (virtual)
+		poke_reg(tracee, SYSARG_RESULT, (word_t) error);
+	return 0;
+}
+
+static int handle_statfs_exit(Tracee *tracee, struct CgroupConfig *config)
+{
+	word_t sysnum = get_sysnum(tracee, ORIGINAL);
+	word_t result = peek_reg(tracee, CURRENT, SYSARG_RESULT);
+	char path[PATH_MAX];
+	word_t buffer_address;
+
+	if ((int) result != 0)
+		return 0;
+
+	switch (sysnum) {
+	case PR_statfs:
+	case PR_statfs64:
+		if (read_path(tracee, path, peek_reg(tracee, MODIFIED, SYSARG_1)) < 0
+		    && read_path(tracee, path, peek_reg(tracee, ORIGINAL, SYSARG_1)) < 0)
+			return 0;
+		if (strncmp(path, config->root, strlen(config->root)) != 0
+		    || (path[strlen(config->root)] != '\0'
+			&& path[strlen(config->root)] != '/'))
+			return 0;
+		buffer_address = sysnum == PR_statfs64
+			? peek_reg(tracee, ORIGINAL, SYSARG_3)
+			: peek_reg(tracee, ORIGINAL, SYSARG_2);
+		fake_statfs_magic(tracee, buffer_address);
+		return 0;
+
+	case PR_fstatfs:
+	case PR_fstatfs64:
+		if (!fd_is_virtual(tracee, config,
+				   (int) peek_reg(tracee, CURRENT, SYSARG_1)))
+			return 0;
+		buffer_address = sysnum == PR_fstatfs64
+			? peek_reg(tracee, ORIGINAL, SYSARG_3)
+			: peek_reg(tracee, ORIGINAL, SYSARG_2);
+		fake_statfs_magic(tracee, buffer_address);
+		return 0;
+
+	default:
+		return 0;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Extension entry points                                             */
+/* ------------------------------------------------------------------ */
+
+static struct CgroupConfig *config_of(Extension *extension)
+{
+	return talloc_get_type_abort(extension->config, struct CgroupConfig);
+}
+
+int cgroup_callback(Extension *extension, ExtensionEvent event,
+		intptr_t data1, intptr_t data2)
+{
+	Tracee *tracee = TRACEE(extension);
+	struct CgroupConfig *config;
+
+	switch (event) {
+	case INITIALIZATION: {
+		const char *root;
+		const char *freezer_root;
+
+		config = talloc_zero(extension, struct CgroupConfig);
+		if (config == NULL)
+			return -ENOMEM;
+		LIST_INIT(&config->groups);
+		LIST_INIT(&config->procs);
+		LIST_INIT(&config->aliases);
+
+		root = create_temp_directory(extension, "proot-cgroup");
+		if (root == NULL)
+			return -ENOMEM;
+		config->root = talloc_strdup(config, root);
+		if (config->root == NULL)
+			return -ENOMEM;
+
+		/* cgroup v1's freezer path is kept empty: a proot daemon
+		 * sweeps /dev/freezer/ct for leftover chroot groups, and it
+		 * must never see or kill a real host v1 group.  */
+		freezer_root = create_temp_directory(extension,
+						    "proot-cgroup-freezer");
+		if (freezer_root == NULL)
+			return -ENOMEM;
+		config->freezer_root = talloc_strdup(config, freezer_root);
+		if (config->freezer_root == NULL)
+			return -ENOMEM;
+
+		extension->config = config;
+		extension->filtered_sysnums = filtered_sysnums;
+
+		(void) group_get(config, "/");
+		populate_group(config, "/");
+		if (alias_add(config, DEFAULT_GUEST_ROOT, true, true, NULL) < 0)
+			return -ENOMEM;
+		if (alias_add(config, "/dev/freezer", true, false,
+			      config->freezer_root) < 0)
+			return -ENOMEM;
+		return 0;
+	}
+
+	case INHERIT_PARENT:
+		/* Shared configuration, but tell the child's copy about its
+		 * process membership.  */
+		return 1;
+
+	case INHERIT_CHILD: {
+		Extension *parent = (Extension *) data1;
+		struct CgroupConfig *parent_config = config_of(parent);
+		char path[PATH_MAX];
+		struct CgroupProc *parent_proc;
+		Tracee *child = TRACEE(extension);
+		Tracee *parent_tracee = TRACEE(parent);
+		pid_t parent_pid = parent_tracee->pid;
+		pid_t tgid;
+
+		extension->config = talloc_reference(extension, parent_config);
+		if (extension->config == NULL)
+			return -ENOMEM;
+		config = parent_config;
+
+		parent_proc = proc_find(config, parent_pid);
+		if (parent_proc != NULL && parent_proc->path != NULL)
+			strcpy(path, parent_proc->path);
+		else
+			strcpy(path, "/");
+
+		tgid = (data2 & CLONE_THREAD) != 0
+			? (parent_proc != NULL ? parent_proc->tgid : parent_pid)
+			: child->pid;
+		(void) proc_set(config, child->pid, path,
+				(data2 & CLONE_THREAD) != 0, tgid);
+		if (path_is_frozen(config, path)) {
+			child->cgroup_frozen = true;
+			(void) kill(child->pid, SIGSTOP);
+		}
+		return 0;
+	}
+
+	case GUEST_PATH:
+		config = config_of(extension);
+		return handle_guest_path(tracee, config, (char *) data1,
+					 (const char *) data2);
+
+	case SYSCALL_ENTER_START: {
+		word_t sysnum;
+		int status;
+
+		config = config_of(extension);
+		(void) ensure_self(tracee, config);
+		sysnum = get_sysnum(tracee, ORIGINAL);
+		switch (sysnum) {
+		case PR_mkdir:
+			return handle_mkdir(tracee, config, AT_FDCWD,
+					    peek_reg(tracee, CURRENT, SYSARG_1));
+		case PR_mkdirat:
+			return handle_mkdir(tracee, config,
+					    (int) peek_reg(tracee, CURRENT, SYSARG_1),
+					    peek_reg(tracee, CURRENT, SYSARG_2));
+		case PR_rmdir:
+			return handle_rmdir(tracee, config, AT_FDCWD,
+					    peek_reg(tracee, CURRENT, SYSARG_1));
+		case PR_unlink:
+			return handle_unlink(tracee, config, AT_FDCWD,
+					     peek_reg(tracee, CURRENT, SYSARG_1), false);
+		case PR_unlinkat: {
+			word_t flags = peek_reg(tracee, CURRENT, SYSARG_3);
+			return handle_unlink(tracee, config,
+					     (int) peek_reg(tracee, CURRENT, SYSARG_1),
+					     peek_reg(tracee, CURRENT, SYSARG_2),
+					     (flags & AT_REMOVEDIR) != 0);
+		}
+		case PR_mknod:
+		case PR_mknodat: {
+			char host[PATH_MAX];
+			int dirfd = sysnum == PR_mknod
+				? AT_FDCWD
+				: (int) peek_reg(tracee, CURRENT, SYSARG_1);
+			word_t path = sysnum == PR_mknod
+				? peek_reg(tracee, CURRENT, SYSARG_1)
+				: peek_reg(tracee, CURRENT, SYSARG_2);
+			char group[PATH_MAX];
+
+			status = resolve_host_path(tracee, dirfd, path, host, NULL);
+			if (status < 0)
+				return reject_syscall(tracee, -EPERM);
+			if (host_to_group(config, host, group))
+				return reject_syscall(tracee, -EPERM);
+			return 0;
+		}
+		case PR_symlink:
+		case PR_symlinkat: {
+			char host[PATH_MAX];
+			char group[PATH_MAX];
+			int dirfd = sysnum == PR_symlink
+				? AT_FDCWD
+				: (int) peek_reg(tracee, CURRENT, SYSARG_2);
+			word_t path = sysnum == PR_symlink
+				? peek_reg(tracee, CURRENT, SYSARG_2)
+				: peek_reg(tracee, CURRENT, SYSARG_3);
+
+			status = resolve_host_path(tracee, dirfd, path, host, NULL);
+			if (status < 0)
+				return reject_syscall(tracee, -EPERM);
+			if (host_to_group(config, host, group))
+				return reject_syscall(tracee, -EPERM);
+			return 0;
+		}
+		case PR_link:
+		case PR_linkat: {
+			char host[PATH_MAX];
+			char group[PATH_MAX];
+			int old_dirfd = sysnum == PR_link
+				? AT_FDCWD
+				: (int) peek_reg(tracee, CURRENT, SYSARG_1);
+			int new_dirfd = sysnum == PR_link
+				? AT_FDCWD
+				: (int) peek_reg(tracee, CURRENT, SYSARG_3);
+			word_t old_path = sysnum == PR_link
+				? peek_reg(tracee, CURRENT, SYSARG_1)
+				: peek_reg(tracee, CURRENT, SYSARG_2);
+			word_t new_path = sysnum == PR_link
+				? peek_reg(tracee, CURRENT, SYSARG_2)
+				: peek_reg(tracee, CURRENT, SYSARG_4);
+
+			status = resolve_host_path(tracee, old_dirfd, old_path,
+						   host, NULL);
+			if (status < 0)
+				return reject_syscall(tracee, -EPERM);
+			if (host_to_group(config, host, group))
+				return reject_syscall(tracee, -EPERM);
+			status = resolve_host_path(tracee, new_dirfd, new_path,
+						   host, NULL);
+			if (status < 0)
+				return reject_syscall(tracee, -EPERM);
+			if (host_to_group(config, host, group))
+				return reject_syscall(tracee, -EPERM);
+			return 0;
+		}
+		case PR_truncate:
+		case PR_truncate64: {
+			char host[PATH_MAX];
+			char group[PATH_MAX];
+
+			status = resolve_host_path(tracee, AT_FDCWD,
+						   peek_reg(tracee, CURRENT, SYSARG_1),
+						   host, NULL);
+			if (status < 0)
+				return reject_syscall(tracee, -EINVAL);
+			if (host_to_group(config, host, group))
+				return reject_syscall(tracee, -EINVAL);
+			return 0;
+		}
+		case PR_rename:
+			return handle_rename(tracee, config, AT_FDCWD,
+					     peek_reg(tracee, CURRENT, SYSARG_1),
+					     AT_FDCWD,
+					     peek_reg(tracee, CURRENT, SYSARG_2));
+		case PR_renameat:
+			return handle_rename(tracee, config,
+					     (int) peek_reg(tracee, CURRENT, SYSARG_1),
+					     peek_reg(tracee, CURRENT, SYSARG_2),
+					     (int) peek_reg(tracee, CURRENT, SYSARG_3),
+					     peek_reg(tracee, CURRENT, SYSARG_4));
+		case PR_renameat2: {
+			word_t flags = peek_reg(tracee, CURRENT, SYSARG_5);
+			if ((flags & ~(word_t) RENAME_NOREPLACE) != 0)
+				return -EINVAL;
+			return handle_rename(tracee, config,
+					     (int) peek_reg(tracee, CURRENT, SYSARG_1),
+					     peek_reg(tracee, CURRENT, SYSARG_2),
+					     (int) peek_reg(tracee, CURRENT, SYSARG_3),
+					     peek_reg(tracee, CURRENT, SYSARG_4));
+		}
+		case PR_write:
+		case PR_pwrite64:
+		case PR_writev:
+		case PR_pwritev:
+		case PR_pwritev2:
+			status = handle_write(tracee, config);
+			return status;
+		case PR_mount:
+			return handle_mount(tracee, config);
+		case PR_umount:
+		case PR_umount2:
+			return handle_umount(tracee, config);
+		default:
+			return 0;
+		}
+	}
+
+	case SYSCALL_EXIT_END:
+		config = config_of(extension);
+		(void) enforce_cgroup_exit(tracee, config);
+		return handle_statfs_exit(tracee, config);
+
+	case NEW_STATUS: {
+		int status = (int) data1;
+
+		if (!WIFEXITED(status) && !WIFSIGNALED(status))
+			return 0;
+		config = config_of(extension);
+		{
+			struct CgroupProc *proc = proc_find(config, tracee->pid);
+			if (proc != NULL) {
+				char path[PATH_MAX];
+				if (proc->path != NULL)
+					strcpy(path, proc->path);
+				else
+					strcpy(path, "/");
+				proc_drop(config, proc);
+				touch_events(config, path);
+			}
+		}
+		return 0;
+	}
+
+	case PRINT_CONFIG: {
+		config = config_of(extension);
+		fprintf(stderr, "cgroup root = %s\n", config->root);
+		return 0;
+	}
+
+	case PRINT_USAGE:
+		fprintf(stderr, "--cgroup\tEmulate an unprivileged cgroup v2 hierarchy\n");
+		return 0;
+
+	case REMOVED:
+	default:
+		return 0;
+	}
+}
+
+bool cgroup_needs_mountinfo(Tracee *tracee)
+{
+	return get_extension(tracee, cgroup_callback) != NULL;
+}
+
+void cgroup_append_mountinfo(Tracee *tracee, FILE *fp)
+{
+	Extension *extension;
+	struct CgroupConfig *config;
+	struct CgroupAlias *alias;
+	int id = 1000000;
+
+	extension = get_extension(tracee, cgroup_callback);
+	if (extension == NULL)
+		return;
+	config = config_of(extension);
+
+	LIST_FOREACH(alias, &config->aliases, link) {
+		if (!alias->cgroup2)
+			continue;
+		fprintf(fp,
+			"%d 1 0:26 / %s rw,nosuid,nodev,noexec,relatime - cgroup2 cgroup2 rw\n",
+			id++, alias->path);
+	}
+}
