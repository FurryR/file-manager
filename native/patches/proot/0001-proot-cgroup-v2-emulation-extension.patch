--- a/src/tracee/event.c
+++ b/src/tracee/event.c
@@ -669,25 +669,31 @@ int handle_tracee_event(Tracee *tracee, int tracee_status)
 			break;
 
 		case SIGSTOP:
+			/* cgroup.freeze owns the stop: leave the tracee in
+			 * its ptrace-stop until cgroup::thaw restarts it.  */
+			if (tracee->cgroup_frozen) {
+				signal = -1;
+				break;
+			}
 			/* Stop this tracee until PRoot has received
 			 * the EVENT_*FORK|CLONE notification.  */
 			if (tracee->exe == NULL) {
 				tracee->sigstop = SIGSTOP_PENDING;
 				signal = -1;
 			}
-
-			/* For each tracee, the first SIGSTOP
-			 * is only used to notify the tracer.  */
-			if (tracee->sigstop == SIGSTOP_IGNORED) {
+			else if (tracee->sigstop == SIGSTOP_IGNORED) {
+				/* The first SIGSTOP after exec is a real
+				 * job-control/stop request, not the startup
+				 * handshake.  Deliver it: cgroup.freeze and
+				 * ordinary "kill -STOP" depend on it.  */
 				tracee->sigstop = SIGSTOP_ALLOWED;
-				signal = 0;
 			}
 			break;
 
 		case SIGSYS: {
 			siginfo_t siginfo = {};
 			ptrace(PTRACE_GETSIGINFO, tracee->pid, NULL, &siginfo);
-			if (siginfo.si_code == SYS_SECCOMP) {
+			if (siginfo.si_code == PROOT_SYS_SECCOMP) {
 				/* Signal cannot happen when we're inside syscall,
 				 * tracee would have to exit from syscall first.
 				 * Execute exit handler now if seccomp triggered sysexit skip.  */
diff --git a/src/tracee/tracee.h b/src/tracee/tracee.h
index 7ac4ad1..092ac8c 100644
--- a/src/tracee/tracee.h
+++ b/src/tracee/tracee.h
@@ -192,6 +192,10 @@ typedef struct tracee {
 		SIGSTOP_PENDING,      /* Block SIGSTOP until the parent is unknown.  */
 	} sigstop;
 
+	/* Set while cgroup.freeze wants this tracee to stay stopped.  The
+	 * event loop must not restart it when its SIGSTOP arrives.  */
+	bool cgroup_frozen;
+
 	/* True if next SIGSYS caused by seccomp should be silently dropped
 	 * without affecting state of any registers.  */
 	bool skip_next_seccomp_signal;
