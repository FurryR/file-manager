+static void test_events_inotify(void)
+{
+	char path[512];
+	char value[32];
+	char buffer[4096];
+	struct pollfd pollfd;
+	int inotify;
+	int watch;
+	int found = 0;
+	int i;
+
+	make_group("ev");
+	snprintf(path, sizeof(path), "%s/ev/cgroup.events", CG);
+	inotify = inotify_init1(IN_NONBLOCK | IN_CLOEXEC);
+	if (inotify < 0)
+		fail("inotify_init1");
+	watch = inotify_add_watch(inotify, path, IN_MODIFY | IN_ATTRIB);
+	if (watch < 0)
+		fail("inotify_add_watch");
+
+	pollfd.fd = inotify;
+	pollfd.events = POLLIN;
+	pollfd.revents = 0;
+	check(poll(&pollfd, 1, 0) >= 0, "poll inotify");
+
+	snprintf(value, sizeof(value), "%d\n", (int) getpid());
+	if (write_text(CG "/ev/cgroup.procs", value) < 0)
+		fail("move self into ev");
+
+	for (i = 0; i < 100; i++) {
+		pollfd.revents = 0;
+		if (poll(&pollfd, 1, 20) > 0) {
+			ssize_t length = read(inotify, buffer, sizeof(buffer));
+			char *cursor = buffer;
+			while (length > 0 && cursor < buffer + length) {
+				struct inotify_event *event =
+					(struct inotify_event *) cursor;
+				if ((event->mask & IN_MODIFY) != 0) {
+					found = 1;
+					break;
+				}
+				cursor += sizeof(*event) + event->len;
+			}
+		}
+		if (found)
+			break;
+	}
+	check(found != 0, "no inotify IN_MODIFY for cgroup.events");
+	check(read_text(path, buffer, sizeof(buffer)) >= 0,
+	      "read events after inotify");
+	check(strstr(buffer, "populated 1") != NULL,
+	      "events after move = '%s'", buffer);
+
+	close(inotify);
+	if (write_text(CG "/cgroup.procs", value) < 0)
+		fail("move self back to root");
+	remove_group("ev");
+}
