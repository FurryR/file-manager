index 0000000..d85c076
--- /dev/null
+++ b/tests/cgroup/README.md
@@ -0,0 +1,36 @@
+# cgroup emulation tests
+
+`--cgroup` presents `/sys/fs/cgroup` as a private cgroup v2 hierarchy
+backed by material from `/proc/<pid>/stat` (`ppid`, `pgrp`, `session`,
+`starttime`) and PRoot's own fork/exit events.  These tests run each case
+inside a fresh PRoot instance, so every case starts with an empty virtual
+hierarchy rooted at `/`.
+
+```bash
+bash tests/cgroup/run.sh
+```
+
+The cases cover:
+
+| Case | What it exercises |
+|------|-------------------|
+| `root_layout` | cgroup2 `statfs` magic, root files, controllers, `/proc/self/cgroup`, `/proc/cgroups`, absent resource files |
+| `mkdir_rmdir` | directory lifecycle, `EEXIST`, `ENOTEMPTY`, `EBUSY`, root protection |
+| `membership_inheritance` | `cgroup.procs` writes, fork inheritance, `/proc/<pid>/cgroup`, populated events |
+| `move_process_tree` | moving a process while its existing child stays behind; new children inherit the new group |
+| `dirfd_operations` | the native daemon's `O_PATH` + `openat`/`unlinkat` pattern for procs, events, kill and rmdir |
+| `kill_subtree` | `cgroup.kill` reaches descendants that called `setsid`; invalid kill values |
+| `freeze_thaw` | real scheduling stop, frozen counter check, inherited freeze for migrated processes, thaw |
+| `threads` | `cgroup.procs` vs `cgroup.threads`, per-thread migration, sibling retention |
+| `proc_cgroup_and_mount` | `/proc/<pid>/cgroup`, a cgroup2 mount at another path, `statfs`, mountinfo, unmount |
+| `subtree_control` | no-internal-process `EBUSY`, controller delegation, child controller views |
+| `limits_and_type` | `cgroup.max.depth`, `cgroup.max.descendants`, `domain`/`threaded` type |
+| `events_inotify` | `cgroup.events` modification notifications for service managers |
+| `errors_and_permissions` | `ESRCH`, `EINVAL`, write-only/read-only files, mknod/symlink/unlink rejection |
+| `rename_group` | renaming a group updates membership and `/proc/<pid>/cgroup` |
+| `service_manager_flow` | systemd-like slice/service creation, freeze, kill, removal |
+| `hierarchy_events` | nested groups, inherited `frozen`, subtree kill |
+
+Resource controllers are intentionally unavailable: the test suite asserts
+that `memory.max` and other limit files do not exist.  The non-resource
+parts of cgroup v2 used for service management are implemented.
diff --git a/tests/cgroup/cgroup_test.c b/tests/cgroup/cgroup_test.c
new file mode 100644
index 0000000..10dab6d
--- /dev/null
+++ b/tests/cgroup/cgroup_test.c
@@ -0,0 +1,1346 @@
+/*
+ * Behaviour tests for PRoot's --cgroup extension.
+ *
+ * This program runs *inside* PRoot, with /sys/fs/cgroup backed by the
+ * extension.  Each test case is a separate PRoot invocation so the virtual
+ * hierarchy starts empty.  See run.sh.
+ */
+
+#define _GNU_SOURCE
+
+#include <sys/inotify.h>
+#include <sys/mount.h>
+#include <sys/stat.h>
+#include <sys/statfs.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#define CG "/sys/fs/cgroup"
+#define CGROUP2_SUPER_MAGIC 0x63677270
+#define RESOURCE_NAMES \
+	"cpu cpuset io memory hugetlb pids rdma misc"
+
+static const char *standard_files[] = {
+	"cgroup.procs",
+	"cgroup.threads",
+	"cgroup.kill",
+	"cgroup.freeze",
+	"cgroup.events",
+	"cgroup.controllers",
+	"cgroup.subtree_control",
+	"cgroup.stat",
+	"cgroup.max.depth",
+	"cgroup.max.descendants",
+	"cgroup.type",
+	"cgroup.pressure",
+	"cgroup.available",
+};
+
+static void fail(const char *format, ...)
+{
+	va_list ap;
+
+	fprintf(stderr, "FAIL: ");
+	va_start(ap, format);
+	vfprintf(stderr, format, ap);
+	va_end(ap);
+	fprintf(stderr, " (errno=%d %s)\n", errno, strerror(errno));
+	exit(1);
+}
+
+static void check(bool condition, const char *format, ...)
+{
+	va_list ap;
+
+	if (condition)
+		return;
+	fprintf(stderr, "FAIL: ");
+	va_start(ap, format);
+	vfprintf(stderr, format, ap);
+	va_end(ap);
+	fprintf(stderr, " (errno=%d %s)\n", errno, strerror(errno));
+	exit(1);
+}
+
+static void msleep(int milliseconds)
+{
+	struct timespec ts = {
+		.tv_sec = milliseconds / 1000,
+		.tv_nsec = (long) (milliseconds % 1000) * 1000000L,
+	};
+	nanosleep(&ts, NULL);
+}
+
+static ssize_t read_text(const char *path, char *buffer, size_t size)
+{
+	ssize_t length;
+	int fd;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	length = read(fd, buffer, size - 1);
+	close(fd);
+	if (length < 0)
+		return -1;
+	buffer[length] = '\0';
+	return length;
+}
+
+static int write_text(const char *path, const char *text)
+{
+	size_t length = strlen(text);
+	ssize_t written;
+	int fd;
+
+	fd = open(path, O_WRONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	written = write(fd, text, length);
+	close(fd);
+	if (written != (ssize_t) length) {
+		if (written >= 0)
+			errno = EIO;
+		return -1;
+	}
+	return 0;
+}
+
+static char *trim(char *text)
+{
+	char *end;
+
+	while (*text == ' ' || *text == '\t' || *text == '\n' || *text == '\r')
+		text++;
+	end = text + strlen(text);
+	while (end > text
+	       && (end[-1] == ' ' || end[-1] == '\t'
+		   || end[-1] == '\n' || end[-1] == '\r'))
+		*--end = '\0';
+	return text;
+}
+
+static bool text_has_pid(const char *text, pid_t pid)
+{
+	char copy[65536];
+	char *save;
+	char *token;
+
+	if (strlen(text) >= sizeof(copy))
+		return false;
+	strcpy(copy, text);
+	for (token = strtok_r(copy, " \t\r\n", &save);
+	     token != NULL;
+	     token = strtok_r(NULL, " \t\r\n", &save)) {
+		char *end;
+		long value = strtol(token, &end, 10);
+		if (*end == '\0' && value == pid)
+			return true;
+	}
+	return false;
+}
+
+static bool procs_has(const char *group, pid_t pid)
+{
+	char path[512];
+	char text[65536];
+
+	snprintf(path, sizeof(path), "%s/%s/cgroup.procs", CG, group);
+	if (read_text(path, text, sizeof(text)) < 0)
+		fail("read %s", path);
+	return text_has_pid(text, pid);
+}
+
+static void wait_procs_has(const char *group, pid_t pid)
+{
+	int i;
+
+	for (i = 0; i < 300; i++) {
+		if (procs_has(group, pid))
+			return;
+		msleep(10);
+	}
+	fail("%s never listed pid %d", group, (int) pid);
+}
+
+static bool threads_has(const char *group, pid_t tid)
+{
+	char path[512];
+	char text[65536];
+
+	snprintf(path, sizeof(path), "%s/%s/cgroup.threads", CG, group);
+	if (read_text(path, text, sizeof(text)) < 0)
+		fail("read %s", path);
+	return text_has_pid(text, tid);
+}
+
+static char process_state(pid_t pid)
+{
+	char path[64];
+	char text[1024];
+	char *close;
+	ssize_t length;
+
+	snprintf(path, sizeof(path), "/proc/%d/stat", (int) pid);
+	length = read_text(path, text, sizeof(text));
+	if (length < 0)
+		return '?';
+	close = strrchr(text, ')');
+	if (close == NULL || close[1] == '\0')
+		return '?';
+	return close[2];
+}
+
+static bool process_dead(pid_t pid)
+{
+	char path[64];
+	struct stat st;
+
+	snprintf(path, sizeof(path), "/proc/%d", (int) pid);
+	if (stat(path, &st) < 0)
+		return errno == ENOENT;
+	return process_state(pid) == 'Z' || process_state(pid) == 'X';
+}
+
+static void wait_dead(pid_t pid)
+{
+	int i;
+
+	for (i = 0; i < 300; i++) {
+		if (process_dead(pid))
+			return;
+		msleep(10);
+	}
+	fail("pid %d is still alive", (int) pid);
+}
+
+static void wait_state(pid_t pid, bool stopped)
+{
+	int i;
+
+	for (i = 0; i < 300; i++) {
+		char state = process_state(pid);
+		bool is_stopped = state == 't' || state == 'T';
+
+		if (stopped == is_stopped)
+			return;
+		msleep(10);
+	}
+	fail("pid %d did not become %s (state=%c)", (int) pid,
+	     stopped ? "stopped" : "running", process_state(pid));
+}
+
+static void make_group(const char *path)
+{
+	char full[512];
+
+	snprintf(full, sizeof(full), "%s/%s", CG, path);
+	if (mkdir(full, 0755) < 0)
+		fail("mkdir %s", full);
+}
+
+static void remove_group(const char *path)
+{
+	char full[512];
+
+	snprintf(full, sizeof(full), "%s/%s", CG, path);
+	if (rmdir(full) < 0)
+		fail("rmdir %s", full);
+}
+
+static void move_pid(const char *group, pid_t pid)
+{
+	char path[512];
+	char value[32];
+
+	snprintf(path, sizeof(path), "%s/%s/cgroup.procs", CG, group);
+	snprintf(value, sizeof(value), "%d\n", (int) pid);
+	if (write_text(path, value) < 0)
+		fail("move pid %d to %s", (int) pid, group);
+}
+
+static void check_standard_files(const char *group)
+{
+	char path[512];
+	size_t i;
+
+	for (i = 0; i < sizeof(standard_files) / sizeof(standard_files[0]); i++) {
+		snprintf(path, sizeof(path), "%s/%s/%s", CG, group, standard_files[i]);
+		if (access(path, F_OK) < 0)
+			fail("missing %s", path);
+	}
+}
+
+static void expect_error(long result, int error, const char *what)
+{
+	check(result == -1, "%s unexpectedly succeeded", what);
+	check(errno == error, "%s: expected errno %d, got %d", what, error, errno);
+}
+
+/* ------------------------------------------------------------------ */
+
+static void test_root_layout(void)
+{
+	char path[512];
+	char text[4096];
+	char *value;
+	struct stat st;
+	struct statfs fs;
+	size_t i;
+	int fd;
+
+	check(stat("/sys/fs/cgroup", &st) == 0, "stat /sys/fs/cgroup");
+	check(S_ISDIR(st.st_mode), "cgroup root is not a directory");
+
+	check(statfs("/sys/fs/cgroup", &fs) == 0, "statfs cgroup root");
+	check((unsigned long) fs.f_type == CGROUP2_SUPER_MAGIC,
+	      "cgroup root filesystem type is %lx, not cgroup2",
+	      (unsigned long) fs.f_type);
+
+	fd = open("/sys/fs/cgroup", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	check(fd >= 0, "open cgroup root");
+	check(fstatfs(fd, &fs) == 0, "fstatfs cgroup root");
+	check((unsigned long) fs.f_type == CGROUP2_SUPER_MAGIC,
+	      "fstatfs did not report cgroup2 magic");
+	close(fd);
+
+	for (i = 0; i < sizeof(standard_files) / sizeof(standard_files[0]); i++) {
+		snprintf(path, sizeof(path), "%s/%s", CG, standard_files[i]);
+		check(access(path, F_OK) == 0, "missing root file %s", path);
+	}
+
+	check(read_text(CG "/cgroup.controllers", text, sizeof(text)) >= 0,
+	      "read controllers");
+	value = trim(text);
+	check(strcmp(value, RESOURCE_NAMES) == 0,
+	      "root controllers = '%s', expected '%s'", value, RESOURCE_NAMES);
+
+	check(read_text(CG "/cgroup.events", text, sizeof(text)) >= 0,
+	      "read events");
+	check(strstr(text, "populated 1") != NULL,
+	      "root cgroup should be populated");
+	check(strstr(text, "frozen 0") != NULL,
+	      "root cgroup should not be frozen");
+
+	check(read_text("/proc/self/cgroup", text, sizeof(text)) >= 0,
+	      "read /proc/self/cgroup");
+	check(strcmp(text, "0::/\n") == 0, "self cgroup = '%s'", text);
+
+	check(read_text("/proc/cgroups", text, sizeof(text)) >= 0,
+	      "read /proc/cgroups");
+	check(strstr(text, "memory") != NULL, "/proc/cgroups has no memory");
+
+	errno = 0;
+	check(access(CG "/memory.max", F_OK) < 0 && errno == ENOENT,
+	      "resource file memory.max should not exist");
+
+	/* The real Android v1 freezer tree must be hidden from the daemon's
+	 * sweep; the virtual v2 hierarchy is authoritative.  */
+	errno = 0;
+	check(access("/dev/freezer/ct", F_OK) < 0 && errno == ENOENT,
+	      "real /dev/freezer/ct leaked into the container");
+}
+
+static void test_mkdir_rmdir(void)
+{
+	char path[512];
+
+	make_group("test.slice");
+	check_standard_files("test.slice");
+
+	errno = 0;
+	expect_error(mkdir(CG "/test.slice", 0755), EEXIST,
+		     "mkdir existing cgroup");
+	make_group("test.slice/child");
+
+	expect_error(rmdir(CG "/test.slice"), ENOTEMPTY, "rmdir parent cgroup");
+	remove_group("test.slice/child");
+	remove_group("test.slice");
+	expect_error(rmdir(CG), EBUSY, "rmdir cgroup root");
+
+	snprintf(path, sizeof(path), "%s/does-not-exist", CG);
+	errno = 0;
+	expect_error(rmdir(path), ENOENT, "rmdir missing cgroup");
+}
+
+static void test_membership_inheritance(void)
+{
+	int ready[2];
+	int grandchild_pipe[2];
+	pid_t child, grandchild;
+	char text[4096];
+
+	if (pipe(ready) < 0 || pipe(grandchild_pipe) < 0)
+		fail("pipe");
+	make_group("svc");
+
+	child = fork();
+	if (child < 0)
+		fail("fork");
+	if (child == 0) {
+		char value[32];
+		pid_t grandchild;
+
+		close(ready[0]);
+		close(grandchild_pipe[0]);
+		snprintf(value, sizeof(value), "%d\n", (int) getpid());
+		if (write_text(CG "/svc/cgroup.procs", value) < 0)
+			_exit(10);
+
+		grandchild = fork();
+		if (grandchild < 0)
+			_exit(11);
+		if (grandchild == 0) {
+			for (;;)
+				pause();
+		}
+		if (write(grandchild_pipe[1], &grandchild, sizeof(grandchild))
+		    != sizeof(grandchild))
+			_exit(12);
+		if (write(ready[1], "x", 1) != 1)
+			_exit(13);
+		for (;;)
+			pause();
+	}
+
+	close(ready[1]);
+	close(grandchild_pipe[1]);
+	check(read(ready[0], text, 1) == 1, "child did not report ready");
+	check(read(grandchild_pipe[0], &grandchild, sizeof(grandchild))
+	      == sizeof(grandchild), "no grandchild pid");
+	close(ready[0]);
+	close(grandchild_pipe[0]);
+
+	check(procs_has("svc", child), "svc does not contain child %d", (int) child);
+	check(procs_has("svc", grandchild), "svc does not contain grandchild %d",
+	      (int) grandchild);
+	check(read_text("/proc/self/cgroup", text, sizeof(text)) >= 0,
+	      "read self cgroup");
+	check(strcmp(text, "0::/\n") == 0, "test process moved unexpectedly");
+
+	snprintf(text, sizeof(text), "/proc/%d/cgroup", (int) child);
+	{
+		char content[256];
+		check(read_text(text, content, sizeof(content)) >= 0,
+		      "read child cgroup");
+		check(strcmp(content, "0::/svc\n") == 0,
+		      "child cgroup = '%s'", content);
+	}
+	snprintf(text, sizeof(text), "/proc/%d/cgroup", (int) grandchild);
+	{
+		char content[256];
+		check(read_text(text, content, sizeof(content)) >= 0,
+		      "read grandchild cgroup");
+		check(strcmp(content, "0::/svc\n") == 0,
+		      "grandchild cgroup = '%s'", content);
+	}
+
+	check(read_text(CG "/svc/cgroup.events", text, sizeof(text)) >= 0,
+	      "read svc events");
+	check(strstr(text, "populated 1") != NULL,
+	      "svc should be populated");
+
+	if (write_text(CG "/svc/cgroup.kill", "1\n") < 0)
+		fail("cgroup.kill svc");
+
+	waitpid(child, NULL, 0);
+	wait_dead(grandchild);
+	check(!procs_has("svc", child), "dead child still listed");
+	check(!procs_has("svc", grandchild), "dead grandchild still listed");
+	check(read_text(CG "/svc/cgroup.events", text, sizeof(text)) >= 0,
+	      "read svc events after kill");
+	check(strstr(text, "populated 0") != NULL,
+	      "svc should be empty after kill");
+
+	remove_group("svc");
+}
+
+static void test_move_process_tree(void)
+{
+	int pipefd[2];
+	pid_t child, first, second;
+	char text[4096];
+
+	if (pipe(pipefd) < 0)
+		fail("pipe");
+	make_group("a");
+	make_group("b");
+
+	child = fork();
+	if (child < 0)
+		fail("fork");
+	if (child == 0) {
+		pid_t grandchild;
+		char value[32];
+
+		close(pipefd[0]);
+		snprintf(value, sizeof(value), "%d\n", (int) getpid());
+		if (write_text(CG "/a/cgroup.procs", value) < 0)
+			_exit(10);
+
+		grandchild = fork();
+		if (grandchild == 0)
+			for (;;)
+				pause();
+		if (write(pipefd[1], &grandchild, sizeof(grandchild))
+		    != sizeof(grandchild))
+			_exit(11);
+
+		if (write_text(CG "/b/cgroup.procs", value) < 0)
+			_exit(12);
+
+		grandchild = fork();
+		if (grandchild == 0)
+			for (;;)
+				pause();
+		if (write(pipefd[1], &grandchild, sizeof(grandchild))
+		    != sizeof(grandchild))
+			_exit(13);
+		for (;;)
+			pause();
+	}
+
+	close(pipefd[1]);
+	check(read(pipefd[0], &first, sizeof(first)) == sizeof(first),
+	      "no first grandchild");
+	check(read(pipefd[0], &second, sizeof(second)) == sizeof(second),
+	      "no second grandchild");
+	close(pipefd[0]);
+
+	wait_procs_has("a", first);
+	wait_procs_has("b", child);
+	wait_procs_has("b", second);
+	check(!procs_has("a", child), "child should have moved out of a");
+	check(procs_has("a", first), "first grandchild should stay in a");
+	check(procs_has("b", child), "child should be in b");
+	check(procs_has("b", second), "second grandchild should inherit b");
+	check(!procs_has("b", first), "first grandchild moved unexpectedly");
+
+	snprintf(text, sizeof(text), "/proc/%d/cgroup", (int) child);
+	{
+		char content[256];
+		check(read_text(text, content, sizeof(content)) >= 0,
+		      "read child cgroup");
+		check(strcmp(content, "0::/b\n") == 0, "child cgroup = '%s'",
+		      content);
+	}
+	snprintf(text, sizeof(text), "/proc/%d/cgroup", (int) first);
+	{
+		char content[256];
+		check(read_text(text, content, sizeof(content)) >= 0,
+		      "read grandchild cgroup");
+		check(strcmp(content, "0::/a\n") == 0, "grandchild cgroup = '%s'",
+		      content);
+	}
+
+	if (write_text(CG "/a/cgroup.kill", "1\n") < 0
+	    || write_text(CG "/b/cgroup.kill", "1\n") < 0)
+		fail("cgroup.kill a/b");
+	waitpid(child, NULL, 0);
+	wait_dead(first);
+	wait_dead(second);
+	remove_group("a");
+	remove_group("b");
+}
+
+static void test_dirfd_operations(void)
+{
+	char text[4096];
+	char value[32];
+	pid_t child;
+	int dirfd;
+	int fd;
+	int rootfd;
+
+	make_group("fd");
+	dirfd = open(CG "/fd", O_PATH | O_DIRECTORY | O_CLOEXEC);
+	check(dirfd >= 0, "open cgroup directory with O_PATH");
+
+	child = fork();
+	if (child < 0)
+		fail("fork");
+	if (child == 0)
+		for (;;)
+			pause();
+
+	snprintf(value, sizeof(value), "%d\n", (int) child);
+	fd = openat(dirfd, "cgroup.procs", O_WRONLY | O_CLOEXEC);
+	check(fd >= 0, "openat cgroup.procs through O_PATH dirfd");
+	check(write(fd, value, strlen(value)) == (ssize_t) strlen(value),
+	      "write cgroup.procs through O_PATH dirfd");
+	close(fd);
